      trailTimer=0;
      const p=ballTrailParticles.find(x=>x.life<=0);
      if(p){
        p.mesh.position.copy(ball.position);
        p.mesh.visible=true;
        p.life=0.35;
        const hue=0.55+speed/100;
        p.mesh.material.color.setHSL(Math.min(hue,0.9),1,0.6);
        p.mesh.material.opacity=0.5;
      }
    }
    ballTrailParticles.forEach(p=>{
      if(p.life<=0){p.mesh.visible=false;return;}
      p.life-=dt;
      p.mesh.material.opacity=Math.max(0,p.life/0.35*0.5);
      p.mesh.scale.setScalar(p.life/0.35);
    });
  }
