  function connectWS(){
    const url=document.getElementById('serverUrl').value||'ws://localhost:8080';
    try{ws=new WebSocket(url);}catch(e){alert('Invalid WebSocket URL');return;}
    ws.onopen=()=>{document.getElementById('roomInfo').textContent='Connected to server';document.getElementById('privateControls').style.display='block';};
    ws.onclose=()=>{document.getElementById('roomInfo').textContent='Disconnected';peerConnected=false;roomCode=null;isHost=false;document.getElementById('startOnlineBtn').style.display='none';};
    ws.onerror=()=>{document.getElementById('roomInfo').textContent='Connection error';};
    ws.onmessage=(msg)=>{
      let m={};try{m=JSON.parse(msg.data);}catch(e){return;}
      if(m.type==='room_created'){roomCode=m.code;isHost=true;document.getElementById('roomInfo').textContent=`Room: ${roomCode} (waiting)`;document.getElementById('startOnlineBtn').style.display='none';}
      else if(m.type==='room_joined'){roomCode=m.code;isHost=false;document.getElementById('roomInfo').textContent=`Joined: ${roomCode}`;}
      else if(m.type==='peer_joined'){peerConnected=true;document.getElementById('roomInfo').textContent=`Peer joined ${roomCode}`;if(isHost)document.getElementById('startOnlineBtn').style.display='inline-block';}
      else if(m.type==='peer_msg'){
        const payload=m.payload||{};
        if(payload.subtype==='state')remoteState=payload.data;
        else if(payload.subtype==='start'){if(gameState!=='playing')beginMatch();}
      }
    };
  }
