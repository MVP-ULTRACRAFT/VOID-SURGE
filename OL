      const cheer=Math.sin(time*person.userData.cheerSpeed+person.userData.cheerOffset);
      person.position.y=person.userData.baseY+cheer*0.02;
      person.children.forEach((part,idx)=>{if(idx>1)part.rotation.z=(idx===2?-1:1)*(0.5+cheer*0.3);});
    });
  }
  function addBallPattern(){
    const pattern=new THREE.Mesh(new THREE.SphereGeometry(BALL_R*1.01,16,16),new THREE.MeshStandardMaterial({color:0x000000,transparent:true,opacity:0.3,wireframe:true}));
    ball.add(pattern);
    for(let i=0;i<12;i++){
      const patch=new THREE.Mesh(new THREE.CircleGeometry(BALL_R*0.3,5),new THREE.MeshStandardMaterial({color:0x111111}));
      const phi=Math.acos(2*Math.random()-1),theta=Math.random()*Math.PI*2,r=BALL_R*1.005;
      patch.position.set(r*Math.sin(phi)*Math.cos(theta),r*Math.sin(phi)*Math.sin(theta),r*Math.cos(phi));
      patch.lookAt(0,0,0);ball.add(patch);
    }
  }

  // ====== PHYSICS ======
  function isCarOnWheels(carObj){
    return Boolean(carObj?.userData.onGround);
  }
  function getCarGroundContactHeight(carObj,groundY){
    const useHitboxGroundContact=Boolean(carObj.userData.useHitboxGroundContact);
    let visualBounds=useHitboxGroundContact?null:carObj.userData.visualBoundsLocal;
    if(!visualBounds&&!useHitboxGroundContact){
      carObj.updateMatrixWorld(true);
      const rootInverse=carObj.matrixWorld.clone().invert();
      visualBounds=new THREE.Box3();
      carObj.traverse(node=>{
        if(!node.isMesh||!node.geometry||!node.visible)return;
        for(let ancestor=node.parent;ancestor&&ancestor!==carObj;ancestor=ancestor.parent){
          if(!ancestor.visible)return;
        }
        if(!node.geometry.boundingBox)node.geometry.computeBoundingBox();
        const bounds=node.geometry.boundingBox;
        if(!bounds)return;
        for(const x of [bounds.min.x,bounds.max.x]){
          for(const y of [bounds.min.y,bounds.max.y]){
            for(const z of [bounds.min.z,bounds.max.z]){
              visualBounds.expandByPoint(
                new THREE.Vector3(x,y,z).applyMatrix4(node.matrixWorld).applyMatrix4(rootInverse)
              );
            }
          }
        }
      });
      carObj.userData.visualBoundsLocal=visualBounds;
    }
    if(!useHitboxGroundContact&&visualBounds&&!visualBounds.isEmpty()){
      let lowestPoint=Infinity;
      for(const x of [visualBounds.min.x,visualBounds.max.x]){
        for(const y of [visualBounds.min.y,visualBounds.max.y]){
          for(const z of [visualBounds.min.z,visualBounds.max.z]){
            lowestPoint=Math.min(
              lowestPoint,
              new THREE.Vector3(
                x*carObj.scale.x,
                y*carObj.scale.y,
                z*carObj.scale.z
              ).applyQuaternion(carObj.quaternion).y
            );
          }
        }
      }
      return groundY-lowestPoint;
    }
    const extents=carObj.userData.hitboxHalfExtents||CAR_HALF_EXTENTS;
    const center=carObj.userData.hitboxCenter||CAR_HITBOX_CENTER;
    const rotatedCenterY=center.clone().applyQuaternion(carObj.quaternion).y;
    const axisX=new THREE.Vector3(1,0,0).applyQuaternion(carObj.quaternion);
    const axisY=new THREE.Vector3(0,1,0).applyQuaternion(carObj.quaternion);
    const axisZ=new THREE.Vector3(0,0,1).applyQuaternion(carObj.quaternion);
    const verticalRadius=
      Math.abs(axisX.y)*extents.x+
      Math.abs(axisY.y)*extents.y+
      Math.abs(axisZ.y)*extents.z;
    return groundY-rotatedCenterY+verticalRadius;
  }
  function getFieldGroundHeight(x,z){
    const goalFloorFrontZ=FIELD_L/2-FIELD_EDGE_BEVEL;
    const goalFloorBackZ=GOAL_LINE+GOAL_DEPTH;
    const absZ=Math.abs(z);
    if(absZ>=goalFloorFrontZ&&absZ<=goalFloorBackZ){
      if(Math.abs(x)<=FIELD_W/2-FIELD_CORNER_RADIUS+0.8)return 0;
    }
    const halfWidth=FIELD_W/2,halfLength=FIELD_L/2;
    const cornerX=Math.abs(x)-(halfWidth-FIELD_CORNER_RADIUS);
    const cornerZ=Math.abs(z)-(halfLength-FIELD_CORNER_RADIUS);
    const outsideDistance=
      Math.hypot(Math.max(cornerX,0),Math.max(cornerZ,0))+
      Math.min(Math.max(cornerX,cornerZ),0)-FIELD_CORNER_RADIUS;
    if(outsideDistance>=0)return 0;
    const distanceToEdge=-outsideDistance;
    if(distanceToEdge>=FIELD_EDGE_BEVEL)return 0;
    const rampOffset=FIELD_EDGE_BEVEL-Math.max(0,distanceToEdge);
    return FIELD_EDGE_BEVEL*(
      1-Math.sqrt(Math.max(0,1-(rampOffset/FIELD_EDGE_BEVEL)**2))
    );
  }
  function getArenaBoundary(x,z){
    const coreX=FIELD_W/2-FIELD_CORNER_RADIUS;
    const coreZ=FIELD_L/2-FIELD_CORNER_RADIUS;
    const qx=Math.abs(x)-coreX;
    const qz=Math.abs(z)-coreZ;
    let normal;
    let signedDistance;
    if(qx>0&&qz>0){
      const length=Math.hypot(qx,qz);
      normal=new THREE.Vector3(Math.sign(x)*qx/length,0,Math.sign(z)*qz/length);
      signedDistance=FIELD_CORNER_RADIUS-length;
    }else if(qx>qz){
      normal=new THREE.Vector3(x<0?-1:1,0,0);
      signedDistance=FIELD_W/2-Math.abs(x);
    }else{
      normal=new THREE.Vector3(0,0,z<0?-1:1);
      signedDistance=FIELD_L/2-Math.abs(z);
    }
    return{
      signedDistance,
      normal,
      point:new THREE.Vector3(x,0,z).addScaledVector(normal,signedDistance)
    };
  }
  function getTrackSurfaceContact(point){
    const boundary=getArenaBoundary(point.x,point.z);
    const distanceToBoundary=boundary.signedDistance;
    const inGoalTunnel=
      Math.abs(point.x)<GOAL_W/2-1&&
      Math.abs(point.z)>FIELD_L/2-FIELD_EDGE_BEVEL&&
      Math.abs(point.z)<GOAL_LINE+GOAL_DEPTH;
    let closest=null;
    const consider=(surfacePoint,normal)=>{
      const distance=point.distanceTo(surfacePoint);
      if(!closest||distance<closest.distance)closest={point:surfacePoint,normal,distance};
    };
    if(inGoalTunnel||distanceToBoundary>=FIELD_EDGE_BEVEL){
      consider(new THREE.Vector3(point.x,0,point.z),new THREE.Vector3(0,1,0));
    }
    if(!inGoalTunnel&&distanceToBoundary>=0&&distanceToBoundary<=FIELD_EDGE_BEVEL){
      const relativeHeight=FIELD_EDGE_BEVEL-point.y;
      const angle=Math.atan2(
        FIELD_EDGE_BEVEL-distanceToBoundary,
        relativeHeight
      );
      const clampedAngle=THREE.MathUtils.clamp(angle,0,Math.PI/2);
      const surfaceDistance=FIELD_EDGE_BEVEL*(1-Math.sin(clampedAngle));
      const surfaceHeight=FIELD_EDGE_BEVEL*(1-Math.cos(clampedAngle));
      const surfacePoint=boundary.point.clone()
        .addScaledVector(boundary.normal,-surfaceDistance)
        .setY(surfaceHeight);
      const normal=boundary.normal.clone().multiplyScalar(-Math.sin(clampedAngle))
        .add(new THREE.Vector3(0,Math.cos(clampedAngle),0)).normalize();
      consider(surfacePoint,normal);
    }
    if(!inGoalTunnel&&
       Math.abs(distanceToBoundary)<=2.8&&
       point.y>=FIELD_EDGE_BEVEL-1.6&&
       point.y<=FIELD_H+2){
      const wallPoint=boundary.point.clone();
      wallPoint.y=THREE.MathUtils.clamp(point.y,FIELD_EDGE_BEVEL,FIELD_H);
      consider(wallPoint,boundary.normal.clone().negate());
    }
    return closest;
  }
  function getCarFlatFloorContactHeight(carObj){
    const boundary=getArenaBoundary(carObj.position.x,carObj.position.z);
    const inGoalTunnel=
      Math.abs(carObj.position.x)<GOAL_W/2-1&&
      Math.abs(carObj.position.z)>FIELD_L/2-FIELD_EDGE_BEVEL&&
      Math.abs(carObj.position.z)<GOAL_LINE+GOAL_DEPTH;
    if(boundary.signedDistance<FIELD_EDGE_BEVEL&&!inGoalTunnel)return null;
    return getCarGroundContactHeight(
      carObj,getFieldGroundHeight(carObj.position.x,carObj.position.z)
    );
  }
  function isCarOnFlatFloor(carObj){
    const floorContactHeight=getCarFlatFloorContactHeight(carObj);
    return floorContactHeight!==null&&
      carObj.position.y<=floorContactHeight+0.18&&
      carObj.position.y>=floorContactHeight-0.5;
  }
  function getCarWheelContacts(carObj,maxDistance){
    const extents=carObj.userData.hitboxHalfExtents||CAR_HALF_EXTENTS;
    const wheelX=Math.min(1.55,extents.x*0.72);
    const wheelZ=Math.min(2.35,extents.z*0.74);
    const visualBounds=carObj.userData.visualBoundsLocal;
    const localY=carObj.userData.useHitboxGroundContact?
      -extents.y:
      visualBounds&&!visualBounds.isEmpty()?visualBounds.min.y*carObj.scale.y:
      -(carObj.userData.groundHeight||0.85);
    const localAnchors=[
      new THREE.Vector3(-wheelX,localY,wheelZ),
      new THREE.Vector3(wheelX,localY,wheelZ),
      new THREE.Vector3(-wheelX,localY,-wheelZ),
      new THREE.Vector3(wheelX,localY,-wheelZ)
    ];
    carObj.updateMatrixWorld(true);
    return localAnchors.map((localPoint,index)=>{
      const wheelPoint=localPoint.applyQuaternion(carObj.quaternion).add(carObj.position);
      const surface=getTrackSurfaceContact(wheelPoint);
      if(!surface||surface.distance>maxDistance)return null;
      return{index,point:wheelPoint,surfacePoint:surface.point,normal:surface.normal,distance:surface.distance};
    }).filter(Boolean);
  }
  function shouldKeepCarDetached(carObj){
    if(!carObj.userData.surfaceJumped)return false;
    if(getCarWheelContacts(carObj,2.4).length>0)return true;
    carObj.userData.surfaceJumped=false;
    return false;
  }
  function getWheelPlanePose(carObj,contacts){
    const averageNormal=contacts.reduce(
      (sum,contact)=>sum.add(contact.normal),new THREE.Vector3()
    ).normalize();
    let up=averageNormal;
    const byIndex=new Map(contacts.map(contact=>[contact.index,contact]));
    if([0,1,2,3].every(index=>byIndex.has(index))){
      const front=byIndex.get(0).surfacePoint.clone().add(byIndex.get(1).surfacePoint)
        .multiplyScalar(0.5);
      const rear=byIndex.get(2).surfacePoint.clone().add(byIndex.get(3).surfacePoint)
        .multiplyScalar(0.5);
      const left=byIndex.get(0).surfacePoint.clone().add(byIndex.get(2).surfacePoint)
        .multiplyScalar(0.5);
      const right=byIndex.get(1).surfacePoint.clone().add(byIndex.get(3).surfacePoint)
        .multiplyScalar(0.5);
      const fittedUp=front.sub(rear).cross(right.sub(left)).normalize();
      if(fittedUp.lengthSq()>0.5){
        if(fittedUp.dot(averageNormal)<0)fittedUp.negate();
        up=fittedUp;
      }
    }
    if(up.lengthSq()<0.5)up.set(0,1,0);
    const forward=new THREE.Vector3(0,0,1).applyQuaternion(carObj.quaternion)
      .projectOnPlane(up);
    if(forward.lengthSq()<1e-6){
      forward.set(0,0,1).projectOnPlane(up);
      if(forward.lengthSq()<1e-6)forward.set(1,0,0).projectOnPlane(up);
    }
    forward.normalize();
    const right=up.clone().cross(forward).normalize();
    forward.copy(right).cross(up).normalize();
    const rotationMatrix=new THREE.Matrix4().makeBasis(right,up,forward);
    return{
      normal:up,
      quaternion:new THREE.Quaternion().setFromRotationMatrix(rotationMatrix)
    };
  }
  function applyWheelSurfaceContact(carObj,vel,dt){
    if(shouldKeepCarDetached(carObj)){
      carObj.userData.onGround=false;
      return;
    }
    let contacts=getCarWheelContacts(carObj,1.8);
    if(contacts.length<2){
      carObj.userData.onGround=isCarOnFlatFloor(carObj);
      if(carObj.userData.onGround){
        carObj.userData.surfaceNormal.set(0,1,0);
        carObj.userData.jumpSurfaceNormal.set(0,1,0);
        carObj.userData.wheelContacts=0;
      }
      return;
    }
    carObj.userData.surfaceJumped=false;
    const pose=getWheelPlanePose(carObj,contacts);
    carObj.userData.onGround=true;
    carObj.userData.surfaceNormal.copy(pose.normal);
    if(!carObj.userData.dodgeActive&&!carObj.userData.rightingActive){
      carObj.quaternion.slerp(pose.quaternion,1-Math.exp(-7*dt));
    }
    contacts=getCarWheelContacts(carObj,2.4);
    if(contacts.length<2)return;
    const correction=contacts.reduce(
      (sum,contact)=>sum.add(contact.surfacePoint.clone().sub(contact.point)),
      new THREE.Vector3()
    ).multiplyScalar(1/contacts.length);
    const correctionLength=correction.length();
    if(correctionLength>0.3)correction.setLength(0.3);
    carObj.position.add(correction);
    const surfaceNormal=carObj.userData.surfaceNormal;
    const normalSpeed=vel.dot(surfaceNormal);
    vel.addScaledVector(surfaceNormal,-normalSpeed);
    carObj.userData.wheelContacts=contacts.length;
  }
  function getGoalTunnelHalfWidth(z){
    return GOAL_W/2;
  }
  function getCarCeilingContactHeight(carObj,ceilingY){
    const extents=carObj.userData.hitboxHalfExtents||CAR_HALF_EXTENTS;
    const center=carObj.userData.hitboxCenter||CAR_HITBOX_CENTER;
    const rotatedCenterY=center.clone().applyQuaternion(carObj.quaternion).y;
    const axisX=new THREE.Vector3(1,0,0).applyQuaternion(carObj.quaternion);
    const axisY=new THREE.Vector3(0,1,0).applyQuaternion(carObj.quaternion);
    const axisZ=new THREE.Vector3(0,0,1).applyQuaternion(carObj.quaternion);
    const verticalRadius=
      Math.abs(axisX.y)*extents.x+
      Math.abs(axisY.y)*extents.y+
      Math.abs(axisZ.y)*extents.z;
    return ceilingY-rotatedCenterY-verticalRadius;
  }
  function updateDemolishedCar(carObj,vel,dt,isPlayer){
    if(!carObj.userData.demolished)return false;
    carObj.userData.demoTimer=Math.max(0,carObj.userData.demoTimer-dt);
    if(carObj.userData.demoTimer>1e-6)return true;
    carObj.visible=true;
    carObj.userData.demolished=false;
    carObj.userData.demoTimer=0;
    carObj.userData.onGround=true;
    carObj.userData.firstJumpTime=null;
    carObj.userData.dodgeActive=false;
    carObj.userData.dodgeLandingRecovery=false;
    carObj.userData.dodgeStartQuaternion=null;
    carObj.userData.dodgeHeadingYaw=null;
    carObj.userData.dodgeRecoveryPending=false;
    carObj.userData.dodgePitchInputBlocked=false;
    carObj.userData.rightingActive=false;
    carObj.userData.rightingElapsed=0;
    carObj.userData.rightingStartQuaternion=null;
    carObj.userData.rightingTargetQuaternion=null;
    carObj.userData.dodgeSpeedBoostTimer=0;
    carObj.userData.dodgeRecoveryTimer=0;
    carObj.userData.jumpHoldTime=0;
    carObj.userData.cameraYaw=carObj.userData.spawnYaw||0;
    if(carObj.userData.boostFlame)carObj.userData.boostFlame.visible=false;
    carObj.userData.angularVelocity.set(0,0,0);
    vel.set(0,0,0);
    if(isPlayer)playerJumps=0;
    else aiJumps=0;
    return false;
  }
  function demolishCar(carObj,vel,isPlayer){
    if(carObj.userData.demolished)return;
    const smokePosition=carObj.position.clone();
    smokePosition.y+=1.2;
    spawnDemolitionSmoke(smokePosition);
    carObj.userData.demolished=true;
    carObj.userData.demoTimer=CAR_DEMOLITION_DURATION;
    carObj.userData.rightingActive=false;
    carObj.visible=false;
    if(carObj.userData.boostFlame)carObj.userData.boostFlame.visible=false;
    carObj.userData.angularVelocity.set(0,0,0);
    vel.set(0,0,0);
    if(isPlayer)playerJumps=0;
    else aiJumps=0;
  }
  function updateCarPhysics(carObj,vel,input,dt){
    if(updateDemolishedCar(carObj,vel,dt,Boolean(input.isPlayer)))return;
    const wasGrounded=Boolean(carObj.userData.onGround);
    const stayingDetached=shouldKeepCarDetached(carObj);
    let contacts=stayingDetached?[]:
      getCarWheelContacts(carObj,carObj.userData.onGround?1.8:1.05);
    if(contacts.length>=2){
      const pose=getWheelPlanePose(carObj,contacts);
      carObj.userData.onGround=true;
      carObj.userData.surfaceNormal.copy(pose.normal);
      carObj.userData.wheelContacts=contacts.length;
    }else if(isCarOnFlatFloor(carObj)){
      carObj.userData.onGround=true;
      carObj.userData.surfaceNormal.set(0,1,0);
      carObj.userData.jumpSurfaceNormal.set(0,1,0);
      carObj.userData.wheelContacts=0;
    }else{
      carObj.userData.onGround=false;
      carObj.userData.wheelContacts=0;
    }
    const wheelsDown=isCarOnWheels(carObj);
    const surfaceNormal=carObj.userData.surfaceNormal;
    if(!carObj.userData.jumpSurfaceNormal){
      carObj.userData.jumpSurfaceNormal=new THREE.Vector3(0,1,0);
    }
    if(carObj.userData.onGround){
      carObj.userData.jumpSurfaceNormal.copy(surfaceNormal);
    }
    const yaw=carObj.userData.dodgeActive&&Number.isFinite(carObj.userData.dodgeHeadingYaw)?
      carObj.userData.dodgeHeadingYaw:carObj.rotation.y;
    const fwd=new THREE.Vector3(0,0,1).applyQuaternion(carObj.quaternion);
    const right=new THREE.Vector3(1,0,0).applyQuaternion(carObj.quaternion);
    if(wheelsDown){
      fwd.projectOnPlane(surfaceNormal).normalize();
      right.projectOnPlane(surfaceNormal).normalize();
    }
    const acceleration=wheelsDown?input.accel*CAR_ACCELERATION:0;
    vel.addScaledVector(fwd,acceleration*dt);
    if(input.boost){
      const boostDirection=new THREE.Vector3(0,0,1).applyQuaternion(carObj.quaternion);
      const boostMultiplier=carObj.userData.onGround?1:CAR_AIR_BOOST_MULTIPLIER;
      vel.addScaledVector(boostDirection,CAR_BOOST_ACCELERATION*boostMultiplier*dt);
    }
    carObj.userData.dodgeSpeedBoostTimer=Math.max(0,(carObj.userData.dodgeSpeedBoostTimer||0)-dt);
    if(carObj.userData.onGround&&
       (carObj.userData.dodgeActive||carObj.userData.dodgeRecoveryPending)){
      carObj.userData.dodgeRecoveryTimer=CAR_DODGE_RECOVERY_DURATION;
      carObj.userData.dodgeRecoveryPending=false;
    }
    if(carObj.userData.onGround){
      carObj.userData.dodgeRecoveryTimer=Math.max(0,(carObj.userData.dodgeRecoveryTimer||0)-dt);
    }
    const lat=vel.dot(right);
    const dodgeRecoveryRatio=THREE.MathUtils.clamp(
      (carObj.userData.dodgeRecoveryTimer||0)/CAR_DODGE_RECOVERY_DURATION,0,1
    );
    const groundGrip=input.powerslide?CAR_POWERSLIDE_GRIP:CAR_LATERAL_GRIP;
    const recoveryGrip=THREE.MathUtils.lerp(
      groundGrip,Math.min(groundGrip,CAR_DODGE_RECOVERY_GRIP),dodgeRecoveryRatio
    );
    const lateralGrip=wheelsDown?recoveryGrip:
      carObj.userData.onGround?CAR_TIPPED_GROUND_GRIP:0.15;
    const lateralCorrection=lat*(1-Math.exp(-
      (lateralGrip+(!carObj.userData.onGround?CAR_AIR_DRAG:0))*dt
    ));
    vel.addScaledVector(right,-lateralCorrection);
    const fwdSpd=vel.dot(fwd);
    vel.addScaledVector(fwd,-fwdSpd*CAR_FORWARD_DRAG*dt);
    const dodgeBoostRatio=(carObj.userData.dodgeSpeedBoostTimer||0)/CAR_DODGE_BOOST_DURATION;
    const maxAllowedSpeed=CAR_MAX_SPEED*(1+(CAR_DODGE_SPEED_MULTIPLIER-1)*dodgeBoostRatio);
    const maxSpeed=Math.abs(fwdSpd)>maxAllowedSpeed?
      Math.sign(fwdSpd)*maxAllowedSpeed:fwdSpd;
    vel.addScaledVector(fwd,maxSpeed-fwdSpd);
    const speedFactor=Math.min(1,Math.abs(fwdSpd)/5);
    const turnDir=fwdSpd>=0?1:-1;
    const angularVelocity=carObj.userData.angularVelocity;
    const slideTurnBoost=input.powerslide?1.35:1;
    const carUp=new THREE.Vector3(0,1,0).applyQuaternion(carObj.quaternion);
    const upAlignment=carUp.dot(surfaceNormal);
    const invertedOnGround=carObj.userData.onGround&&upAlignment<=CAR_INVERTED_REST_DOT;
    const desiredYawRate=wheelsDown?
      input.steer*CAR_STEER_RATE*speedFactor*turnDir*slideTurnBoost:
      invertedOnGround?-input.steer*CAR_STEER_RATE*speedFactor*turnDir*slideTurnBoost:
      !carObj.userData.onGround?input.steer*CAR_AIR_STEER_RATE*turnDir:0;
    angularVelocity.y=THREE.MathUtils.lerp(angularVelocity.y,desiredYawRate,1-Math.exp(-14*dt));
    if(wheelsDown||invertedOnGround){
      const turnAxis=invertedOnGround?surfaceNormal.clone().negate():surfaceNormal;
      carObj.quaternion.premultiply(
        new THREE.Quaternion().setFromAxisAngle(turnAxis,angularVelocity.y*dt)
      );
      carObj.userData.cameraYaw=carObj.rotation.y;
    }
    const jumpPressed=Boolean(input.jumpPressed);
    const jumpCount=input.isPlayer?playerJumps:aiJumps;
    let nextJumpCount=jumpCount;
    if(carObj.userData.onGround){
      const carUp=new THREE.Vector3(0,1,0).applyQuaternion(carObj.quaternion);
      const carIsFlatOnWheels=wheelsDown&&carUp.dot(surfaceNormal)>=CAR_JUMP_RESET_UPRIGHT_DOT;
      if(carIsFlatOnWheels)nextJumpCount=0;
      carObj.userData.jumpHoldTime=0;
      carObj.userData.firstJumpTime=null;
      if(!carObj.userData.dodgeActive){
        carObj.userData.dodgeElapsed=0;
        carObj.userData.dodgeStartQuaternion=null;
        carObj.userData.dodgeHeadingYaw=null;
      }
      carObj.userData.dodgeRecoveryPending=false;
      carObj.userData.dodgePitchInputBlocked=false;
      if(!carObj.userData.dodgeActive&&!carObj.userData.rightingActive){
        if(wheelsDown){
          if(surfaceNormal.y>0.995){
            const pitchError=Math.atan2(Math.sin(carObj.rotation.x),Math.cos(carObj.rotation.x));
            const rollError=Math.atan2(Math.sin(carObj.rotation.z),Math.cos(carObj.rotation.z));
            angularVelocity.x+=(-pitchError*CAR_LANDING_SUSPENSION_STIFFNESS-
              angularVelocity.x*CAR_LANDING_SUSPENSION_DAMPING)*dt;
            angularVelocity.z+=(-rollError*CAR_LANDING_SUSPENSION_STIFFNESS-
              angularVelocity.z*CAR_LANDING_SUSPENSION_DAMPING)*dt;
            carObj.rotation.x+=angularVelocity.x*dt;
            carObj.rotation.z+=angularVelocity.z*dt;
          }else{
            angularVelocity.x*=Math.exp(-5*dt);
            angularVelocity.z*=Math.exp(-5*dt);
          }
        }else if(carUp.y>CAR_INVERTED_REST_DOT){
          const balanceProgress=THREE.MathUtils.clamp(
            (carUp.y-CAR_TIP_THRESHOLD_DOT)/CAR_GROUND_TIP_TRANSITION+0.5,0,1
          );
          const balanceWeight=balanceProgress*balanceProgress*(3-2*balanceProgress);
          const pitchSpring=-Math.sin(carObj.rotation.x)*CAR_LANDING_SUSPENSION_STIFFNESS;
          const pitchTip=Math.sin(carObj.rotation.x)*CAR_GROUND_TIP_ACCELERATION;
          const rollSpring=-Math.sin(carObj.rotation.z)*CAR_LANDING_SUSPENSION_STIFFNESS;
          const rollTip=Math.sin(carObj.rotation.z)*CAR_GROUND_TIP_ACCELERATION;
          angularVelocity.x+=(
            THREE.MathUtils.lerp(pitchTip,pitchSpring,balanceWeight)-
            angularVelocity.x*CAR_GROUND_TIP_DAMPING
          )*dt;
          angularVelocity.z+=(
            THREE.MathUtils.lerp(rollTip,rollSpring,balanceWeight)-
            angularVelocity.z*CAR_GROUND_TIP_DAMPING
          )*dt;
          carObj.rotation.x+=angularVelocity.x*dt;
          carObj.rotation.z+=angularVelocity.z*dt;
        }else{
          const wrapAngle=angle=>Math.atan2(Math.sin(angle),Math.cos(angle));
          const pitchRoofTarget=Math.PI+Math.round((carObj.rotation.x-Math.PI)/(Math.PI*2))*Math.PI*2;
          const rollZeroTarget=Math.round(carObj.rotation.z/(Math.PI*2))*Math.PI*2;
          const pitchZeroTarget=Math.round(carObj.rotation.x/(Math.PI*2))*Math.PI*2;
          const rollRoofTarget=Math.PI+Math.round((carObj.rotation.z-Math.PI)/(Math.PI*2))*Math.PI*2;
          const pitchRoofError=wrapAngle(pitchRoofTarget-carObj.rotation.x);
          const rollZeroError=wrapAngle(rollZeroTarget-carObj.rotation.z);
          const pitchZeroError=wrapAngle(pitchZeroTarget-carObj.rotation.x);
          const rollRoofError=wrapAngle(rollRoofTarget-carObj.rotation.z);
          const usePitchRest=pitchRoofError*pitchRoofError+rollZeroError*rollZeroError<=
            pitchZeroError*pitchZeroError+rollRoofError*rollRoofError;
          const pitchError=usePitchRest?pitchRoofError:pitchZeroError;
          const rollError=usePitchRest?rollZeroError:rollRoofError;
          angularVelocity.x+=(pitchError*CAR_ROOF_SETTLE_STIFFNESS-
            angularVelocity.x*CAR_ROOF_SETTLE_DAMPING)*dt;
          angularVelocity.z+=(rollError*CAR_ROOF_SETTLE_STIFFNESS-
            angularVelocity.z*CAR_ROOF_SETTLE_DAMPING)*dt;
          carObj.rotation.x+=angularVelocity.x*dt;
          carObj.rotation.z+=angularVelocity.z*dt;
        }
      }
    }
    const currentCarUp=new THREE.Vector3(0,1,0).applyQuaternion(carObj.quaternion);
    const jumpSurfaceNormal=carObj.userData.onGround?
      surfaceNormal:carObj.userData.jumpSurfaceNormal;
    const jumpAlignment=currentCarUp.dot(jumpSurfaceNormal);
    const needsGroundRighting=carObj.userData.onGround&&surfaceNormal.y>0.9&&
      jumpAlignment<CAR_JUMP_RESET_UPRIGHT_DOT;
    const canJumpWhileUpright=jumpAlignment>=CAR_JUMP_RESET_UPRIGHT_DOT;
    const direction=input.dodgeDirection||new THREE.Vector2();
    const jumpTime=input.simulationTime??physicsTime;
    const secondJumpWindowOpen=carObj.userData.firstJumpTime!==null&&
      jumpTime-carObj.userData.firstJumpTime<=CAR_DODGE_WINDOW;
    const canSecondJump=nextJumpCount===1&&canJumpWhileUpright&&
      secondJumpWindowOpen;
    const canDodge=!carObj.userData.onGround&&nextJumpCount===1&&
      currentCarUp.dot(jumpSurfaceNormal)>=CAR_AIR_DODGE_UPRIGHT_DOT&&
      carObj.userData.firstJumpTime!==null&&
      jumpTime-carObj.userData.firstJumpTime<=CAR_DODGE_WINDOW&&
      direction.lengthSq()>0;
    if(jumpPressed&&(needsGroundRighting||
       (canJumpWhileUpright&&nextJumpCount<2&&
        (nextJumpCount!==1||canSecondJump))||canDodge)){
      if(canDodge){
        const dodge=direction.clone();
        dodge.normalize();
        const dodgeWorld=right.clone().multiplyScalar(dodge.x).add(fwd.clone().multiplyScalar(dodge.y));
        vel.addScaledVector(dodgeWorld,CAR_DODGE_IMPULSE);
        vel.addScaledVector(jumpSurfaceNormal,CAR_DODGE_VERTICAL_IMPULSE);
        angularVelocity.y=0;
        if(dodge.y!==0){
          angularVelocity.x=0;
          angularVelocity.z=0;
          carObj.userData.dodgePitchInputBlocked=true;
        }
        carObj.userData.dodgeSpeedBoostTimer=CAR_DODGE_BOOST_DURATION;
        carObj.userData.dodgeActive=true;
        carObj.userData.dodgeLandingRecovery=true;
        carObj.userData.dodgeElapsed=0;
        carObj.userData.dodgeAnimationDuration=
          Math.abs(dodge.x)<0.1&&Math.abs(dodge.y)>0.9?
            CAR_DODGE_FORWARD_FLIP_DURATION:CAR_DODGE_FLIP_DURATION;
        carObj.userData.dodgeStartQuaternion=carObj.quaternion.clone();
        carObj.userData.dodgeHeadingYaw=yaw;
        carObj.userData.dodgeDirectionY=dodge.y;
        carObj.userData.dodgeAxis=jumpSurfaceNormal.clone().cross(dodgeWorld).normalize();
      }else if(needsGroundRighting){
        carObj.userData.rightingActive=true;
        carObj.userData.rightingElapsed=0;
        carObj.userData.rightingStartQuaternion=carObj.quaternion.clone();
        carObj.userData.rightingTargetQuaternion=new THREE.Quaternion().setFromEuler(
          new THREE.Euler(0,yaw,0)
        );
        carObj.userData.jumpHoldTime=0;
        carObj.userData.firstJumpTime=null;
        carObj.userData.onGround=true;
        vel.y=0;
        angularVelocity.x=0;
        angularVelocity.z=0;
        nextJumpCount=0;
      }else{
        vel.addScaledVector(jumpSurfaceNormal,CAR_JUMP_INITIAL_VELOCITY);
        carObj.userData.surfaceJumped=true;
        if(carObj.userData.onGround){
          carObj.userData.jumpHoldTime=0;
          carObj.userData.firstJumpTime=jumpTime;
          carObj.userData.onGround=false;
        }
        nextJumpCount++;
      }
    }
    if(!carObj.userData.onGround&&input.jump&&nextJumpCount===1&&!carObj.userData.dodgeActive){
      const jumpHoldTime=carObj.userData.jumpHoldTime||0;
      const holdDuration=Math.min(dt,CAR_JUMP_HOLD_DURATION-jumpHoldTime);
      if(holdDuration>0){
        vel.addScaledVector(jumpSurfaceNormal,CAR_JUMP_HOLD_ACCELERATION*holdDuration);
        carObj.userData.jumpHoldTime=jumpHoldTime+holdDuration;
      }
    }
    if(carObj.userData.dodgeActive){
      carObj.userData.dodgeElapsed+=dt;
      const dodgeProgress=THREE.MathUtils.clamp(
        carObj.userData.dodgeElapsed/
          (carObj.userData.dodgeAnimationDuration||CAR_DODGE_FLIP_DURATION),0,1
      );
      const easedDodgeProgress=dodgeProgress*dodgeProgress*(3-2*dodgeProgress);
      const pitchCounterTilt=Math.abs(carObj.userData.dodgeDirectionY)*
        CAR_DODGE_COUNTER_TILT*Math.sin(Math.PI*dodgeProgress)**2;
      const flip=new THREE.Quaternion().setFromAxisAngle(
        carObj.userData.dodgeAxis,
        Math.PI*2*easedDodgeProgress-pitchCounterTilt
      );
      carObj.quaternion.copy(flip).multiply(carObj.userData.dodgeStartQuaternion);
      if(dodgeProgress>=1){
        carObj.userData.cameraYaw=carObj.rotation.y;
        angularVelocity.y=0;
        carObj.userData.dodgeActive=false;
        carObj.userData.dodgeRecoveryPending=true;
        carObj.userData.dodgeAnimationDuration=0;
        if(carObj.userData.onGround)carObj.userData.dodgeLandingRecovery=false;
        carObj.userData.dodgeStartQuaternion=null;
        carObj.userData.dodgeHeadingYaw=null;
      }
    }
    if(!carObj.userData.onGround&&carObj.userData.dodgePitchInputBlocked&&!input.accel){
      carObj.userData.dodgePitchInputBlocked=false;
    }
    if(carObj.userData.rightingActive){
      carObj.userData.rightingElapsed+=dt;
      const rightingProgress=THREE.MathUtils.clamp(
        carObj.userData.rightingElapsed/CAR_GROUND_RIGHTING_DURATION,0,1
      );
      const easedRightingProgress=rightingProgress*rightingProgress*(3-2*rightingProgress);
      carObj.quaternion.slerpQuaternions(
        carObj.userData.rightingStartQuaternion,
        carObj.userData.rightingTargetQuaternion,
        easedRightingProgress
      );
      carObj.position.y=getCarGroundContactHeight(
        carObj,(carObj.userData.groundHeight||0.85)+
          getFieldGroundHeight(carObj.position.x,carObj.position.z)
      );
      vel.y=0;
      if(rightingProgress>=1){
        carObj.userData.rightingActive=false;
        carObj.rotation.set(0,yaw,0);
        carObj.userData.firstJumpTime=null;
        carObj.userData.jumpHoldTime=0;
        carObj.userData.onGround=true;
        vel.y=0;
        nextJumpCount=0;
      }
    }else if(!carObj.userData.onGround){
      if(carObj.userData.angularVelocity){
        const angularVelocity=carObj.userData.angularVelocity;
        if(!carObj.userData.dodgeActive){
          if(carObj.userData.dodgePitchInputBlocked){
            angularVelocity.x*=Math.exp(-CAR_AIR_PITCH_DRAG*dt);
          }else if(input.accel){
            angularVelocity.x=THREE.MathUtils.clamp(
              angularVelocity.x+input.accel*CAR_AIR_PITCH_ACCELERATION*dt,
              -CAR_AIR_PITCH_MAX_SPEED,CAR_AIR_PITCH_MAX_SPEED
            );
          }else angularVelocity.x*=Math.exp(-CAR_AIR_PITCH_DRAG*dt);
          if(input.airRoll){
            angularVelocity.z=THREE.MathUtils.clamp(
              angularVelocity.z+input.airRoll*CAR_AIR_ROLL_ACCELERATION*dt,
              -CAR_AIR_ROLL_MAX_SPEED,CAR_AIR_ROLL_MAX_SPEED
            );
          }else angularVelocity.z*=Math.exp(-CAR_AIR_ROLL_DRAG*dt);
          carObj.rotation.x+=angularVelocity.x*dt;
          carObj.rotation.z+=angularVelocity.z*dt;
          carObj.rotation.y+=angularVelocity.y*dt;
          carObj.userData.cameraYaw=carObj.rotation.y;
        }
        angularVelocity.y*=Math.exp(-2.1*dt);
      }
    }
    if(input.isPlayer)playerJumps=nextJumpCount;
    else aiJumps=nextJumpCount;
    if(carObj.userData.onGround){
      const tangentGravity=new THREE.Vector3(0,GRAVITY,0).projectOnPlane(surfaceNormal);
      if(surfaceNormal.y<0.65&&!input.accel&&Math.abs(vel.dot(fwd))<6){
        tangentGravity.set(0,0,0);
      }
      vel.addScaledVector(tangentGravity,dt);
    }else{
      vel.y+=GRAVITY*dt;
      vel.y*=Math.exp(-CAR_AIR_DRAG*dt);
    }
    carObj.position.addScaledVector(vel,dt);
    const ceilingContactHeight=getCarCeilingContactHeight(carObj,FIELD_H);
    if(carObj.position.y>ceilingContactHeight){
      carObj.position.y=ceilingContactHeight;
      if(vel.y>0)vel.y=-vel.y*0.25;
    }
    const R=2.8;
    const minX=fieldCollisionBounds.minX+R;
    const maxX=fieldCollisionBounds.maxX-R;
    const minZ=fieldCollisionBounds.minZ+R;
    const maxZ=fieldCollisionBounds.maxZ-R;
    const wallApproachContacts=getCarWheelContacts(carObj,2.4);
    const wallApproachPose=wallApproachContacts.length>=2?
      getWheelPlanePose(carObj,wallApproachContacts):null;
    const supportedByIncline=Boolean(wallApproachPose&&wallApproachPose.normal.y<0.995);
    if(!supportedByIncline){
      if(carObj.position.x<minX){carObj.position.x=minX;vel.x=Math.max(0,vel.x)*-0.3;}
      if(carObj.position.x>maxX){carObj.position.x=maxX;vel.x=Math.min(0,vel.x)*-0.3;}
    }
    const goalDepth=Math.abs(carObj.position.z);
    const inGoalDepth=
      goalDepth>=FIELD_L/2-R&&goalDepth<=GOAL_LINE+GOAL_DEPTH;
    const goalSide=Math.sign(carObj.position.z);
    const goalSideLimit=getGoalTunnelHalfWidth(carObj.position.z)-R;
    if(inGoalDepth&&!supportedByIncline){
      if(Math.abs(carObj.position.x)>goalSideLimit){
        if(goalDepth<GOAL_LINE+R){
          carObj.position.z=goalSide*(FIELD_L/2-R);
          if(vel.z*goalSide>0)vel.z=-Math.abs(vel.z)*0.3;
        }else if(carObj.position.x<0){
          carObj.position.x=-goalSideLimit;
          if(vel.x<0)vel.x=-vel.x*0.3;
        }else{
          carObj.position.x=goalSideLimit;
          if(vel.x>0)vel.x=-vel.x*0.3;
        }
      }
    }
    const inGoalLane=inGoalDepth&&
      Math.abs(carObj.position.x)<=getGoalTunnelHalfWidth(carObj.position.z)-R;
    const carMinZ=inGoalLane?-GOAL_LINE-GOAL_DEPTH+R:minZ;
    const carMaxZ=inGoalLane?GOAL_LINE+GOAL_DEPTH-R:maxZ;
    if(!supportedByIncline){
      if(carObj.position.z<carMinZ){carObj.position.z=carMinZ;vel.z=Math.max(0,vel.z)*-0.3;}
      if(carObj.position.z>carMaxZ){carObj.position.z=carMaxZ;vel.z=Math.min(0,vel.z)*-0.3;}
    }
    if(inGoalLane){
      const goalCeilingHeight=getCarCeilingContactHeight(carObj,GOAL_H);
      if(carObj.position.y>goalCeilingHeight){
        carObj.position.y=goalCeilingHeight;
        if(vel.y>0)vel.y=-vel.y*0.25;
      }
    }
    const cornerX=Math.max(Math.abs(carObj.position.x)-(FIELD_W/2-FIELD_CORNER_RADIUS),0);
    const cornerZ=Math.max(Math.abs(carObj.position.z)-(FIELD_L/2-FIELD_CORNER_RADIUS),0);
    const cornerLimit=FIELD_CORNER_RADIUS-R;
    const cornerDistance=Math.hypot(cornerX,cornerZ);
    if(!supportedByIncline&&cornerX>0&&cornerZ>0&&cornerDistance>cornerLimit){
      const normalX=Math.sign(carObj.position.x)*cornerX/cornerDistance;
      const normalZ=Math.sign(carObj.position.z)*cornerZ/cornerDistance;
      const correction=cornerDistance-cornerLimit;
      carObj.position.x-=normalX*correction;
      carObj.position.z-=normalZ*correction;
      const outwardSpeed=vel.x*normalX+vel.z*normalZ;
      if(outwardSpeed>0){
        vel.x-=normalX*outwardSpeed*1.3;
        vel.z-=normalZ*outwardSpeed*1.3;
      }
    }
    const approachNormalSpeed=vel.dot(surfaceNormal);
    applyWheelSurfaceContact(carObj,vel,dt);
    const flatFloorHeight=getCarFlatFloorContactHeight(carObj);
    if(flatFloorHeight!==null&&carObj.position.y<flatFloorHeight){
      carObj.position.y=flatFloorHeight;
      if(vel.y<0)vel.y=0;
      carObj.userData.onGround=true;
      carObj.userData.surfaceNormal.set(0,1,0);
      carObj.userData.jumpSurfaceNormal.set(0,1,0);
      carObj.userData.surfaceJumped=false;
      carObj.userData.wheelContacts=0;
    }
    if(!wasGrounded&&carObj.userData.onGround&&!carObj.userData.dodgeLandingRecovery){
      const impactSpeed=Math.max(0,-approachNormalSpeed);
      if(impactSpeed>1){
        angularVelocity.x-=Math.sin(carObj.rotation.z)*Math.min(impactSpeed,24)*0.12;
        angularVelocity.z+=Math.sin(carObj.rotation.x)*Math.min(impactSpeed,24)*0.12;
      }
      carObj.userData.dodgeLandingRecovery=false;
    }
    if(carObj.userData.boostFlame)carObj.userData.boostFlame.visible=input.boost;
  }
  function resolveCarCollision(carA,velA,isPlayerA,carB,velB,isPlayerB){
    if(!carA?.visible||!carB?.visible||carA.userData.demolished||carB.userData.demolished)return;
    const getShape=carObj=>{
      const extents=carObj.userData.hitboxHalfExtents||CAR_HALF_EXTENTS;
      const center=carObj.userData.hitboxCenter||CAR_HITBOX_CENTER;
      const basis=[
        new THREE.Vector3(1,0,0).applyQuaternion(carObj.quaternion),
        new THREE.Vector3(0,1,0).applyQuaternion(carObj.quaternion),
        new THREE.Vector3(0,0,1).applyQuaternion(carObj.quaternion)
      ];
      return{
        center:center.clone().applyQuaternion(carObj.quaternion).add(carObj.position),
        extents,basis
      };
    };
    const shapeA=getShape(carA),shapeB=getShape(carB);
    const axes=[...shapeA.basis,...shapeB.basis];
    shapeA.basis.forEach(axisA=>shapeB.basis.forEach(axisB=>axes.push(axisA.clone().cross(axisB))));
    let minimumOverlap=Infinity,collisionNormal=null;
    const centerDelta=shapeB.center.clone().sub(shapeA.center);
    for(const axis of axes){
      if(axis.lengthSq()<1e-8)continue;
      axis.normalize();
      const radiusA=shapeA.basis.reduce((sum,basis,index)=>sum+Math.abs(axis.dot(basis))*shapeA.extents.getComponent(index),0);
      const radiusB=shapeB.basis.reduce((sum,basis,index)=>sum+Math.abs(axis.dot(basis))*shapeB.extents.getComponent(index),0);
      const projectedDistance=centerDelta.dot(axis);
      const overlap=radiusA+radiusB-Math.abs(projectedDistance);
      if(overlap<=0)return;
      if(overlap<minimumOverlap){
        minimumOverlap=overlap;
        collisionNormal=axis.clone().multiplyScalar(projectedDistance<0?-1:1);
      }
    }
    if(!collisionNormal)return;
    const inverseMassA=1/CAR_MASS,inverseMassB=1/CAR_MASS;
    const inverseMassSum=inverseMassA+inverseMassB;
    carA.position.addScaledVector(collisionNormal,-minimumOverlap*inverseMassA/inverseMassSum);
    carB.position.addScaledVector(collisionNormal,minimumOverlap*inverseMassB/inverseMassSum);
    const relativeVelocity=velB.clone().sub(velA);
    const normalSpeed=relativeVelocity.dot(collisionNormal);
    if(normalSpeed>=0)return;
    const speedA=Math.hypot(velA.x,velA.z);
    const speedB=Math.hypot(velB.x,velB.z);
    const attackSpeedA=velA.dot(collisionNormal);
    const attackSpeedB=-velB.dot(collisionNormal);
    let demolished=false;
    if(speedA>=CAR_DEMOLITION_SPEED&&attackSpeedA>=CAR_DEMOLITION_SPEED){
      demolishCar(carB,velB,isPlayerB);
      demolished=true;
    }else if(speedB>=CAR_DEMOLITION_SPEED&&attackSpeedB>=CAR_DEMOLITION_SPEED){
      demolishCar(carA,velA,isPlayerA);
      demolished=true;
    }
    if(demolished)return;
    const impulseMagnitude=-(1+CAR_COLLISION_RESTITUTION)*normalSpeed/inverseMassSum;
    const impulse=collisionNormal.multiplyScalar(impulseMagnitude);
    velA.addScaledVector(impulse,-inverseMassA);
    velB.addScaledVector(impulse,inverseMassB);
  }
  function registerGoal(team){
    if(goalReplaySequence)return;
    score[team]++;
    goalsScored++;
    addXP(XP_GOAL);
    updateScore();
    spawnGoalExplosion(ball.position.clone(),team===0?0x3498db:0xe74c3c);
    showGoal(team===0?'BLUE SCORES!':'RED SCORES!');
    if(currentMode==='freeplay')return;
    recordGoalReplayFrame(physicsTime);
    const goalScorer=team===0?'player':'opponent';
    goalReplaySequence={
      phase:'live-delay',
      delayRemaining:GOAL_REPLAY_LIVE_DELAY,
      frames:goalReplayHistory.slice(),
      goalPosition:ball.position.clone(),
      goalColor:team===0?0x3498db:0xe74c3c,
      scorer:goalScorer,
      replayElapsed:0,
      replayDuration:0,
      frameIndex:0,
      postReplayRemaining:0
    };
  }
  function captureGoalReplayFrame(time){
    const captureCar=car=>car?{
      position:car.position.clone(),
      quaternion:car.quaternion.clone(),
      visible:car.visible,
      boostVisible:Boolean(car.userData.boostFlame?.visible)
    }:null;
    return{
      time,
      ballPosition:ball.position.clone(),
      ballQuaternion:ball.quaternion.clone(),
      player:captureCar(playerCarMesh),
      opponent:captureCar(aiCarMesh)
    };
  }
  function recordGoalReplayFrame(time){
    if(!ball||!playerCarMesh||currentMode==='freeplay')return;
    const frame=captureGoalReplayFrame(time);
    const lastFrame=goalReplayHistory[goalReplayHistory.length-1];
    if(lastFrame&&Math.abs(lastFrame.time-time)<1e-8){
      goalReplayHistory[goalReplayHistory.length-1]=frame;
    }else{
      goalReplayHistory.push(frame);
    }
    const oldestAllowedTime=time-GOAL_REPLAY_MAX_SECONDS;
    while(goalReplayHistory.length>1&&goalReplayHistory[1].time<oldestAllowedTime){
      goalReplayHistory.shift();
    }
  }
  function hideGoalReplayUI(){
    document.body.classList.remove('goal-replay');
    const label=document.getElementById('goalReplayLabel');
    const transition=document.getElementById('goalReplayTransition');
    if(label)label.style.display='none';
    if(transition){
      transition.style.transition='none';
      transition.style.opacity='0';
      transition.style.display='none';
    }
  }
  function beginGoalReplay(){
    if(!goalReplaySequence)return;
    const sequence=goalReplaySequence;
    if(!sequence.frames.length){
      sequence.frames=[captureGoalReplayFrame(physicsTime)];
    }
    sequence.phase='replay';
    sequence.replayElapsed=0;
    sequence.replayDuration=Math.max(
      0,
      sequence.frames[sequence.frames.length-1].time-sequence.frames[0].time
    );
    sequence.frameIndex=0;
    gameState='goal-replay';
    document.body.classList.add('goal-replay');
    document.getElementById('goalReplayLabel').style.display='block';
    const transition=document.getElementById('goalReplayTransition');
    transition.style.display='block';
    transition.style.transition='none';
    transition.style.opacity='1';
    transition.offsetHeight;
    requestAnimationFrame(()=>{
      transition.style.transition='opacity 450ms ease-out';
      transition.style.opacity='0';
    });
    setTimeout(()=>{
      if(goalReplaySequence===sequence)transition.style.display='none';
    },500);
    ballTrailParticles.forEach(particle=>{particle.mesh.visible=false;});
    applyGoalReplayFrame(sequence.frames[0],sequence.frames[0],0,sequence);
  }
  function applyGoalReplayFrame(first,second,blend,sequence){
    const applyCar=(car,a,b)=>{
      if(!car||!a||!b)return;
      car.position.lerpVectors(a.position,b.position,blend);
      car.quaternion.copy(a.quaternion).slerp(b.quaternion,blend);
      car.visible=blend<0.5?a.visible:b.visible;
      if(car.userData.boostFlame)car.userData.boostFlame.visible=
        blend<0.5?a.boostVisible:b.boostVisible;
    };
    ball.position.lerpVectors(first.ballPosition,second.ballPosition,blend);
    ball.quaternion.copy(first.ballQuaternion).slerp(second.ballQuaternion,blend);
    applyCar(playerCarMesh,first.player,second.player);
    applyCar(aiCarMesh,first.opponent,second.opponent);

    const scorer=sequence.scorer==='player'?first.player:first.opponent;
    if(scorer){
      const carPosition=scorer.position.clone().lerp(
        sequence.scorer==='player'?second.player.position:second.opponent.position,
        blend
      );
      const focus=carPosition.clone().lerp(ball.position,0.62);
      const playDirection=ball.position.clone().sub(carPosition);
      playDirection.y=0;
      if(playDirection.lengthSq()<1e-6)playDirection.set(0,0,1);
      playDirection.normalize();
      const sideDirection=new THREE.Vector3(-playDirection.z,0,playDirection.x);
      const cameraPosition=focus.clone()
        .addScaledVector(playDirection,-36)
        .addScaledVector(sideDirection,18)
        .add(new THREE.Vector3(0,22,0));
      camera.position.lerp(cameraPosition,0.28);
      camera.lookAt(focus.x,focus.y+2,focus.z);
    }
  }
  function updateGoalReplay(dt,time){
    const sequence=goalReplaySequence;
    if(!sequence)return false;
    if(sequence.phase==='live-delay'){
      sequence.delayRemaining-=dt;
      if(sequence.delayRemaining>0)return false;
      beginGoalReplay();
    }
    if(sequence.phase==='replay'){
      sequence.replayElapsed=Math.min(
        sequence.replayDuration,
        sequence.replayElapsed+dt
      );
      const frames=sequence.frames;
      const replayTime=frames[0].time+sequence.replayElapsed;
      while(sequence.frameIndex<frames.length-2&&
        frames[sequence.frameIndex+1].time<replayTime){
        sequence.frameIndex++;
      }
      const first=frames[sequence.frameIndex];
      const second=frames[Math.min(sequence.frameIndex+1,frames.length-1)];
      const span=second.time-first.time;
      const blend=span>0?THREE.MathUtils.clamp((replayTime-first.time)/span,0,1):0;
      applyGoalReplayFrame(first,second,blend,sequence);
      updateCrowd(time);
      updateExplosionParticles(dt);
      updateDemolitionSmoke(dt);
      if(sequence.replayElapsed>=sequence.replayDuration){
        const finalFrame=frames[frames.length-1];
        ball.position.copy(finalFrame.ballPosition);
        spawnGoalExplosion(sequence.goalPosition,sequence.goalColor);
        sequence.phase='post-replay';
        sequence.postReplayRemaining=GOAL_REPLAY_POST_DELAY;
      }
      return true;
    }
    if(sequence.phase==='post-replay'){
      sequence.postReplayRemaining-=dt;
      updateCrowd(time);
      updateExplosionParticles(dt);
      updateDemolitionSmoke(dt);
      if(sequence.postReplayRemaining<=0){
        goalReplaySequence=null;
        goalReplayHistory=[];
        hideGoalReplayUI();
        resetPositions();
      }
      return true;
    }
    return false;
  }
  function isInsideGoalMouth(x,y){
    const postRadius=0.7;
    return Math.abs(x)<=GOAL_W/2-BALL_R-postRadius&&
      y>=BALL_R&&y<=GOAL_H-BALL_R-postRadius;
  }
  function updateBall(dt){
    const previousPosition=ball.position.clone();
    const trainingShotActive=ball.userData.trainingShotTimeLeft>0;
    if(trainingShotActive){
      ball.userData.trainingShotTimeLeft=Math.max(0,ball.userData.trainingShotTimeLeft-dt);
      if(ball.userData.trainingShotTimeLeft===0)ball.userData.trainingShotGravityScale=null;
    }
    const gravityScale=trainingShotActive&&Number.isFinite(ball.userData.trainingShotGravityScale)?
      ball.userData.trainingShotGravityScale:1;
    ballVel.y+=GRAVITY*1.3*gravityScale*dt;
    ball.position.x+=ballVel.x*dt;ball.position.y+=ballVel.y*dt;ball.position.z+=ballVel.z*dt;
    const groundHeight=getFieldGroundHeight(ball.position.x,ball.position.z);
    if(ball.position.y<groundHeight+BALL_R){
      ball.position.y=groundHeight+BALL_R;
      ballVel.y=-ballVel.y*BALL_GROUND_RESTITUTION;
      if(Math.abs(ballVel.y)<0.7)ballVel.y=0;
    }
    if(ball.position.y>FIELD_H-BALL_R){ball.position.y=FIELD_H-BALL_R;ballVel.y=-ballVel.y*0.45;}
    if(goalCooldown<=0){
      const crossesGoalLine=(line,direction,team)=>{
        const crossed=direction<0?
          previousPosition.z>line&&ball.position.z<=line:
          previousPosition.z<line&&ball.position.z>=line;
        if(!crossed)return false;
        const fraction=(line-previousPosition.z)/(ball.position.z-previousPosition.z);
        const x=THREE.MathUtils.lerp(previousPosition.x,ball.position.x,fraction);
        const y=THREE.MathUtils.lerp(previousPosition.y,ball.position.y,fraction);
        if(!isInsideGoalMouth(x,y))return false;
        if(currentMode==='freeplay')return false;
        registerGoal(team);
        return true;
      };
      if(crossesGoalLine(-GOAL_LINE,-1,1)||crossesGoalLine(GOAL_LINE,1,0))return;
    }
    const ballMinX=fieldCollisionBounds.minX+BALL_R;
    const ballMaxX=fieldCollisionBounds.maxX-BALL_R;
    const ballMinZ=-FIELD_L/2+BALL_R;
    const ballMaxZ=FIELD_L/2-BALL_R;
    if(ball.position.x<ballMinX){ball.position.x=ballMinX;ballVel.x=Math.max(0,ballVel.x)*-0.7;}
    if(ball.position.x>ballMaxX){ball.position.x=ballMaxX;ballVel.x=Math.min(0,ballVel.x)*-0.7;}
    const backNetMinZ=-GOAL_LINE-GOAL_DEPTH+BALL_R;
    const backNetMaxZ=GOAL_LINE+GOAL_DEPTH-BALL_R;
    const inGoalMouth=isInsideGoalMouth(ball.position.x,ball.position.y);
    const inGoalPocket=inGoalMouth&&(
      (ball.position.z<ballMinZ&&ball.position.z>=backNetMinZ)||
      (ball.position.z>ballMaxZ&&ball.position.z<=backNetMaxZ)
    );
    if(ball.position.z<ballMinZ&&!inGoalPocket){
      if(inGoalMouth&&ball.position.z<backNetMinZ){ball.position.z=backNetMinZ;ballVel.z=Math.abs(ballVel.z)*0.55;}
      else{ball.position.z=ballMinZ;ballVel.z=Math.abs(ballVel.z)*0.7;}
    }
    if(ball.position.z>ballMaxZ&&!inGoalPocket){
      if(inGoalMouth&&ball.position.z>backNetMaxZ){ball.position.z=backNetMaxZ;ballVel.z=-Math.abs(ballVel.z)*0.55;}
      else{ball.position.z=ballMaxZ;ballVel.z=-Math.abs(ballVel.z)*0.7;}
    }
    if(!inGoalPocket){
      const cornerX=Math.max(Math.abs(ball.position.x)-(FIELD_W/2-FIELD_CORNER_RADIUS),0);
      const cornerZ=Math.max(Math.abs(ball.position.z)-(FIELD_L/2-FIELD_CORNER_RADIUS),0);
      const cornerDistance=Math.hypot(cornerX,cornerZ);
      const cornerLimit=FIELD_CORNER_RADIUS-BALL_R;
      if(cornerX>0&&cornerZ>0&&cornerDistance>cornerLimit){
        const normalX=Math.sign(ball.position.x)*cornerX/cornerDistance;
        const normalZ=Math.sign(ball.position.z)*cornerZ/cornerDistance;
        ball.position.x-=normalX*(cornerDistance-cornerLimit);
        ball.position.z-=normalZ*(cornerDistance-cornerLimit);
        const outwardSpeed=ballVel.x*normalX+ballVel.z*normalZ;
        if(outwardSpeed>0){
          ballVel.x-=normalX*outwardSpeed*1.7;
          ballVel.z-=normalZ*outwardSpeed*1.7;
        }
      }
    }
    const inGoalX=Math.abs(ball.position.x)<=GOAL_W/2-BALL_R;
    const inGoalY=ball.position.y>=BALL_R*0.5&&ball.position.y<=GOAL_H-BALL_R;
    const inFrontOfGoal=inGoalX&&ball.position.y<GOAL_H-BALL_R+2;
    const isShotTowardFront=ball.position.z<-GOAL_LINE+18&&ballVel.z<-1;
    const isShotTowardBack=ball.position.z>GOAL_LINE-18&&ballVel.z>1;
    // FIX: showShotOnGoal is now defined
    if(currentMode!=='freeplay'&&!ball.userData.shotRegistered&&inFrontOfGoal&&ball.userData.lastTouch){
      const lt=ball.userData.lastTouch;
      let validShot=false;
      if(lt==='player')validShot=isShotTowardBack;
      else validShot=isShotTowardFront;
      if(validShot){
        shotsOnGoal++;
        addXP(XP_SHOT_ON_GOAL);
        showShotOnGoal();
        ball.userData.shotRegistered=true;
      }
    }
    [[-GOAL_W/2,-GOAL_LINE],[GOAL_W/2,-GOAL_LINE],[-GOAL_W/2,GOAL_LINE],[GOAL_W/2,GOAL_LINE]].forEach(([px,pz])=>{
      const dx=ball.position.x-px,dz=ball.position.z-pz;const d=Math.sqrt(dx*dx+dz*dz);
      if(d<BALL_R+0.7&&ball.position.y<GOAL_H){
        const n=1/d;const nx=dx*n,nz=dz*n;
        ball.position.x=px+nx*(BALL_R+0.7);ball.position.z=pz+nz*(BALL_R+0.7);
        const vn=ballVel.x*nx+ballVel.z*nz;
        if(vn<0){ballVel.x-=1.6*vn*nx;ballVel.z-=1.6*vn*nz;}
      }
    });
    collideBallCar(playerCarMesh,carVel,'player');
    if(currentMode!=='freeplay')collideBallCar(aiCarMesh,aiVel,currentMode==='multi'?'p2':'ai');
    const grounded=ball.position.y<=BALL_R+0.001;
    const horizontalSpeed=Math.hypot(ballVel.x,ballVel.z);
    if(grounded){
      const rollingSpeed=Math.max(0,horizontalSpeed-BALL_ROLLING_DECELERATION*dt);
      if(horizontalSpeed>0.001){
        const rollingScale=rollingSpeed/horizontalSpeed;
        ballVel.x*=rollingScale;
        ballVel.z*=rollingScale;
        const rollingAxis=new THREE.Vector3(0,1,0).cross(new THREE.Vector3(ballVel.x,0,ballVel.z));
        const targetSpin=rollingAxis.multiplyScalar(1/BALL_R);
        ballAngularVel.lerp(targetSpin,1-Math.exp(-BALL_ROLLING_SPIN_RESPONSE*dt));
      }
      if(rollingSpeed<0.08){
        ballVel.x=0;ballVel.z=0;
        ballAngularVel.multiplyScalar(Math.exp(-BALL_ROLLING_SPIN_RESPONSE*dt));
      }
    } else {
      const airFactor=trainingShotActive?1:
        Math.max(0,1-BALL_AIR_DRAG*ballVel.length()*dt);
      ballVel.x*=airFactor;
      ballVel.y*=airFactor;
      ballVel.z*=airFactor;
      ballAngularVel.multiplyScalar(Math.exp(-BALL_SPIN_AIR_DRAG*dt));
    }
    const spinSpeed=ballAngularVel.length();
    if(spinSpeed>0.001){
      ball.quaternion.premultiply(new THREE.Quaternion().setFromAxisAngle(ballAngularVel.clone().normalize(),spinSpeed*dt));
    }
    ball.userData.prevZ=ball.position.z;
  }
  function applyCarInverseInertia(carObj,torque){
    const localTorque=torque.clone().applyQuaternion(carObj.quaternion.clone().invert());
    const extents=carObj.userData.hitboxHalfExtents||CAR_HALF_EXTENTS;
    const hx=extents.x,hy=extents.y,hz=extents.z;
    const invI=new THREE.Vector3(
      3/(CAR_MASS*(hy*hy+hz*hz)),
      3/(CAR_MASS*(hx*hx+hz*hz)),
      3/(CAR_MASS*(hx*hx+hy*hy))
    );
    return localTorque.multiply(invI).applyQuaternion(carObj.quaternion);
  }
  function collideBallCar(carObj,cVel,who){
    if(!carObj||!carObj.visible||carObj.userData.demolished)return;
    const inverseRotation=carObj.quaternion.clone().invert();
    const extents=carObj.userData.hitboxHalfExtents||CAR_HALF_EXTENTS;
    const localCenter=carObj.userData.hitboxCenter||CAR_HITBOX_CENTER;
    const boxCenter=localCenter.clone().applyQuaternion(carObj.quaternion).add(carObj.position);
    const localBall=ball.position.clone().sub(boxCenter).applyQuaternion(inverseRotation);
    const closestPoint=new THREE.Vector3(
      THREE.MathUtils.clamp(localBall.x,-extents.x,extents.x),
      THREE.MathUtils.clamp(localBall.y,-extents.y,extents.y),
      THREE.MathUtils.clamp(localBall.z,-extents.z,extents.z)
    );
    let localNormal=localBall.clone().sub(closestPoint);
    let distance=localNormal.length();
    let penetration;
    if(distance>0){
      if(distance>=BALL_R)return;
      penetration=BALL_R-distance;
      localNormal.divideScalar(distance);
    }else{
      const faceDistances=[
        extents.x-Math.abs(localBall.x),
        extents.y-Math.abs(localBall.y),
        extents.z-Math.abs(localBall.z)
      ];
      let axis=0;
      if(faceDistances[1]<faceDistances[axis])axis=1;
      if(faceDistances[2]<faceDistances[axis])axis=2;
      localNormal.set(0,0,0);
      localNormal.setComponent(axis,localBall.getComponent(axis)<0?-1:1);
      closestPoint.copy(localBall);
      closestPoint.setComponent(axis,localNormal.getComponent(axis)*extents.getComponent(axis));
      distance=faceDistances[axis];
      penetration=BALL_R+distance;
    }
    const normal=localNormal.applyQuaternion(carObj.quaternion).normalize();
    const contactPoint=closestPoint.applyQuaternion(carObj.quaternion).add(boxCenter);
    const ballContactOffset=normal.clone().multiplyScalar(-BALL_R);
    const carContactOffset=contactPoint.clone().sub(carObj.position);
    const carAngularVelocity=carObj.userData.angularVelocity||new THREE.Vector3();
    const ballContactVelocity=ballVel.clone().add(ballAngularVel.clone().cross(ballContactOffset));
    const carContactVelocity=cVel.clone().add(carAngularVelocity.clone().cross(carContactOffset));
    const relativeVelocity=ballContactVelocity.sub(carContactVelocity);
    const normalSpeed=relativeVelocity.dot(normal);
    ball.position.addScaledVector(normal,penetration*0.8);
    if(normalSpeed<0){
        ball.userData.lastTouch=who;
        ball.userData.shotRegistered=false;
        ball.userData.trainingShotGravityScale=null;
        ball.userData.trainingShotTimeLeft=0;
        const carAngularTerm=applyCarInverseInertia(carObj,carContactOffset.clone().cross(normal))
          .cross(carContactOffset).dot(normal);
        const ballInertia=0.4*BALL_MASS*BALL_R*BALL_R;
        const ballAngularTerm=ballContactOffset.clone().cross(normal).multiplyScalar(1/ballInertia)
          .cross(ballContactOffset).dot(normal);
        const inverseMassSum=1/BALL_MASS+1/CAR_MASS+carAngularTerm+ballAngularTerm;
        const impulseMagnitude=-(1+BALL_RESTITUTION)*normalSpeed/inverseMassSum;
        const impulse=normal.clone().multiplyScalar(impulseMagnitude);
        ballVel.addScaledVector(impulse,1/BALL_MASS);
        cVel.addScaledVector(impulse,-1/CAR_MASS);
        ballAngularVel.add(ballContactOffset.clone().cross(impulse).multiplyScalar(1/ballInertia));
        if(carObj.userData.angularVelocity)carObj.userData.angularVelocity.add(applyCarInverseInertia(carObj,carContactOffset.clone().cross(impulse.clone().negate())));
        const postImpulseRelativeVelocity=ballVel.clone()
          .add(ballAngularVel.clone().cross(ballContactOffset))
          .sub(cVel.clone().add(carAngularVelocity.clone().cross(carContactOffset)));
        const tangent=postImpulseRelativeVelocity.addScaledVector(normal,-postImpulseRelativeVelocity.dot(normal));
        if(tangent.lengthSq()>1e-8){
          tangent.normalize();
          const carFrictionTerm=applyCarInverseInertia(carObj,carContactOffset.clone().cross(tangent))
            .cross(carContactOffset).dot(tangent);
          const ballFrictionTerm=ballContactOffset.clone().cross(tangent).multiplyScalar(1/ballInertia)
            .cross(ballContactOffset).dot(tangent);
          const frictionMagnitude=THREE.MathUtils.clamp(
            -postImpulseRelativeVelocity.dot(tangent)/(1/BALL_MASS+1/CAR_MASS+carFrictionTerm+ballFrictionTerm),
            -impulseMagnitude*BALL_CONTACT_FRICTION,
            impulseMagnitude*BALL_CONTACT_FRICTION
          );
          const frictionImpulse=tangent.multiplyScalar(frictionMagnitude);
          ballVel.addScaledVector(frictionImpulse,1/BALL_MASS);
          cVel.addScaledVector(frictionImpulse,-1/CAR_MASS);
          ballAngularVel.add(ballContactOffset.clone().cross(frictionImpulse).multiplyScalar(1/ballInertia));
          if(carObj.userData.angularVelocity)carObj.userData.angularVelocity.add(applyCarInverseInertia(carObj,carContactOffset.clone().cross(frictionImpulse.clone().negate())));
        }
        if(who==='player'||who==='p2')checkSave(carObj,who);
    }
  }
  function checkSave(carObj,who){
    if(saveCooldown>0)return;
    const defendZ=(who==='player')?-FIELD_L/2:FIELD_L/2;
    const distFromGoal=Math.abs(ball.position.z-defendZ);
    if((who==='player'&&ball.position.z<-FIELD_L/2+SAVE_ZONE_FAR)||(who==='p2'&&ball.position.z>FIELD_L/2-SAVE_ZONE_FAR)){
      if(distFromGoal<SAVE_ZONE_CLOSE){addXP(XP_EPIC_SAVE);showSaveMessage(`${who==='p2'?'P2 ':''}EPIC SAVE!`,'#f39c12',XP_EPIC_SAVE);}
      else{addXP(XP_SAVE);showSaveMessage(`${who==='p2'?'P2 ':''}SAVE!`,'#2ecc71',XP_SAVE);}
      saveCooldown=1.5;
    }
  }
