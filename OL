  #carSelectContainer .carChoice { min-width: 0; width: 100%; padding: 8px; border-color: rgba(117,155,190,0.35); background: linear-gradient(150deg,rgba(8,18,31,0.98),rgba(25,41,57,0.96)); font-size: 13px; }
  #carSelectContainer .carChoice:hover { border-color: rgba(159,211,255,0.85); background: linear-gradient(150deg,rgba(22,51,78,0.98),rgba(30,58,79,0.96)); }
  #carSelectContainer .carChoice.selected { border-color: #8bd1ff; background: linear-gradient(145deg,rgba(37,102,149,0.94),rgba(13,40,67,0.98)); box-shadow: inset 0 0 0 1px rgba(184,229,255,0.45),0 0 14px rgba(64,167,235,0.42); }
