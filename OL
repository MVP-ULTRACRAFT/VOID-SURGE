  function loadMenuShowcaseCar(){
    const showCar=(model,name='')=>{
      if(menuCarMesh)scene.remove(menuCarMesh);
      const bounds=new THREE.Box3().setFromObject(model);
      const size=bounds.getSize(new THREE.Vector3());
      const center=bounds.getCenter(new THREE.Vector3());
      const scale=18/(Math.max(size.x,size.z)||1);
      model.scale.multiplyScalar(scale);
      model.position.multiplyScalar(scale);
      model.position.add(new THREE.Vector3(
        7.5-center.x*scale,
        0.04-bounds.min.y*scale+
          (name.toLowerCase().includes('octane')?CAR_OCTANE_VISUAL_LIFT:0),
        12-center.z*scale
      ));
      model.rotation.y=0.85;
      model.traverse(node=>{
        if(node.isMesh){
          node.castShadow=true;
          node.receiveShadow=true;
        }
      });
      menuCarMesh=model;
      menuCarMesh.name='mainMenuShowcaseCar';
      scene.add(menuCarMesh);
    };
    if(carModelTemplate){
      showCar(carModelTemplate.clone(true),carModelName);
      return;
    }
    const savedBody=localStorage.getItem('rl3d_body');
    const savedButton=Array.from(document.querySelectorAll('#carSelect .carChoice')).find(button=>button.dataset.carName===savedBody);
    const defaultButton=savedButton||document.querySelector('#carSelect .carChoice[data-car-name="OCTANE"]');
    fetch(defaultButton.dataset.carPath).then(response=>{
      if(!response.ok)throw new Error(`HTTP ${response.status}`);
      return response.arrayBuffer();
    }).then(buffer=>gltfLoader.parse(buffer,'',gltf=>{
      if(!carModelTemplate){
        carModelTemplate=normalizeCarModel(gltf.scene,defaultButton.dataset.carName);
        carModelName=defaultButton.dataset.carName;
      }
      showCar(carModelTemplate.clone(true),defaultButton.dataset.carName);
    },error=>{
      console.error('Menu showcase car loading failed:',error);
    })).catch(error=>console.error('Menu showcase car request failed:',error));
  }
  function buildStadiumSeats(){
    const geometry=new THREE.BoxGeometry(1.25,0.65,0.7);
    const capacity=6000;
    const seats=new THREE.InstancedMesh(geometry,new THREE.MeshStandardMaterial({color:0xffffff,roughness:0.72,metalness:0.12}),capacity);
    const transform=new THREE.Object3D();
    const colors=[0x142641,0x1d3454,0x283d5b,0x346080,0x4a5872,0x657087,0x254d6c];
    let index=0;
    const addSeat=(x,y,z,rotationY)=>{
      if(index>=capacity)return;
      transform.position.set(x,y,z);
      transform.rotation.set(0,rotationY,0);
      transform.updateMatrix();
      seats.setMatrixAt(index,transform.matrix);
      seats.setColorAt(index,new THREE.Color(colors[Math.floor(Math.random()*colors.length)]));
      index++;
    };
    for(let tier=0;tier<20;tier++){
      const x=FIELD_W/2+24+tier*1.6;
      const z=GOAL_LINE+GOAL_DEPTH+14+tier*1.5;
      const y=5+tier*1.15;
      for(let seat=-STADIUM_L/2-28;seat<=STADIUM_L/2+28;seat+=3.1){
        addSeat(-x,y,seat,Math.PI/2);
        addSeat(x,y,seat,-Math.PI/2);
      }
      for(let seat=-STADIUM_W/2-25;seat<=STADIUM_W/2+25;seat+=3.1){
        addSeat(seat,y,-z,0);
        addSeat(seat,y,z,Math.PI);
      }
    }
    seats.count=index;
    seats.instanceMatrix.needsUpdate=true;
    if(seats.instanceColor)seats.instanceColor.needsUpdate=true;
    seats.castShadow=false;
    seats.receiveShadow=true;
    seats.frustumCulled=false;
    scene.add(seats);
    const stadiumTrim=new THREE.Group();
    const trimMat=new THREE.MeshStandardMaterial({color:0x273b50,metalness:0.7,roughness:0.35});
    for(let tier=0;tier<3;tier++){
      const y=31+tier*2;
      const sideZ=STADIUM_L/2+24+tier*7;
      const sideX=STADIUM_W/2+23+tier*7;
      const sideBeam=new THREE.Mesh(new THREE.BoxGeometry(2,0.55,STADIUM_L+75+tier*12),trimMat);
      sideBeam.position.set(sideX,y,0);
      stadiumTrim.add(sideBeam);
      const oppositeBeam=sideBeam.clone();
      oppositeBeam.position.x=-sideX;
      stadiumTrim.add(oppositeBeam);
      const endBeam=new THREE.Mesh(new THREE.BoxGeometry(STADIUM_W+65+tier*12,0.55,2),trimMat);
      endBeam.position.set(0,y,sideZ);
      stadiumTrim.add(endBeam);
      const oppositeEndBeam=endBeam.clone();
      oppositeEndBeam.position.z=-sideZ;
      stadiumTrim.add(oppositeEndBeam);
    }
    scene.add(stadiumTrim);
  }

