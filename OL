  function buildBoostPads(){
    BOOST_PAD_POSITIONS.forEach(([x,z,amount])=>{
      const isLarge=amount===100;
      const pad=new THREE.Group();
      const padColor=isLarge?0xf04444:0x42f05a;
      const base=new THREE.Mesh(
        new THREE.CylinderGeometry(isLarge?5.4:2.8,isLarge?5.4:2.8,0.35,24),
        new THREE.MeshStandardMaterial({color:padColor,emissive:padColor,emissiveIntensity:0.65,metalness:0.35,roughness:0.3})
      );
      base.position.y=0.18;
      base.receiveShadow=true;
      pad.add(base);
      if(isLarge){
        const ring=new THREE.Mesh(
          new THREE.TorusGeometry(4.4,0.32,8,32),
          new THREE.MeshStandardMaterial({color:0xff7777,emissive:0xf04444,emissiveIntensity:0.75,metalness:0.25,roughness:0.25})
        );
        ring.rotation.x=Math.PI/2;
        ring.position.y=0.48;
        pad.add(ring);
        const orb=new THREE.Mesh(
          new THREE.SphereGeometry(2.35,20,16),
          new THREE.MeshStandardMaterial({color:0xff5656,emissive:0xea2525,emissiveIntensity:1.15,metalness:0.2,roughness:0.18})
        );
        orb.position.y=4.4;
        orb.castShadow=true;
        pad.add(orb);
        pad.userData.orb=orb;
      }else{
        const center=new THREE.Mesh(
          new THREE.CylinderGeometry(0.65,0.65,0.12,12),
          new THREE.MeshBasicMaterial({color:0xc2ffd0})
        );
        center.position.y=0.4;
        pad.add(center);
      }
      pad.position.set(x,0,z);
      const glow=new THREE.PointLight(padColor,isLarge?1.5:0.45,isLarge?18:8);
      glow.position.set(x,isLarge?4:1,z);
      scene.add(pad);
      scene.add(glow);
      boostPads.push({mesh:pad,glow,x,z,amount,isLarge,active:true,respawnTimer:0});
    });
  }
  function updateBoostPads(dt){
    if(gameState!=='playing')return;
    boostPads.forEach(pad=>{
      if(!pad.active){
        pad.respawnTimer-=dt;
        if(pad.respawnTimer<=0){
          pad.active=true;
          pad.mesh.visible=true;
          pad.glow.intensity=pad.isLarge?1.5:0.45;
        }
        return;
      }
      // Check player
      if(pad.active&&boost<100&&playerCarMesh?.visible&&!playerCarMesh.userData.demolished){
        const dx=playerCarMesh.position.x-pad.x;
        const dz=playerCarMesh.position.z-pad.z;
        if(Math.sqrt(dx*dx+dz*dz)<(pad.isLarge?7:4)){
          boost=Math.min(100,boost+pad.amount);
          deactivatePad(pad);
        }
      }
      // Check player 2
      if(pad.active&&boost2<100&&aiCarMesh?.visible&&!aiCarMesh.userData.demolished&&currentMode==='multi'){
        const dx=aiCarMesh.position.x-pad.x;
        const dz=aiCarMesh.position.z-pad.z;
        if(Math.sqrt(dx*dx+dz*dz)<(pad.isLarge?7:4)){
          boost2=Math.min(100,boost2+pad.amount);
          deactivatePad(pad);
        }
      } else if(pad.active&&boost2<100&&aiCarMesh?.visible&&!aiCarMesh.userData.demolished){
        const dx=aiCarMesh.position.x-pad.x;
        const dz=aiCarMesh.position.z-pad.z;
        if(Math.sqrt(dx*dx+dz*dz)<(pad.isLarge?7:4)){
          boost2=Math.min(100,boost2+pad.amount);
          deactivatePad(pad);
        }
      }
      // Pulse glow
      const t=clock.getElapsedTime();
      pad.glow.intensity=(pad.isLarge?1.35:0.35)+Math.sin(t*3+pad.x)*0.1;
      if(pad.isLarge&&pad.mesh.userData.orb){
        pad.mesh.userData.orb.position.y=4.35+Math.sin(t*2.2+pad.x)*0.45;
        pad.mesh.userData.orb.rotation.y=t*0.8;
      }
    });
  }
  function deactivatePad(pad){
    pad.active=false;
    pad.mesh.visible=false;
    pad.glow.intensity=0;
    pad.respawnTimer=pad.isLarge?10:4;
  }
  function resetBoostPads(){
    boostPads.forEach(pad=>{
      pad.active=true;
      pad.respawnTimer=0;
      pad.mesh.visible=true;
      pad.glow.visible=true;
      pad.glow.intensity=pad.isLarge?1.5:0.45;
    });
  }

