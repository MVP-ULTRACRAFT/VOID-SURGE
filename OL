  // ====== IMPROVED AI ======
  function updateAI(dt){
    if(!aiCarMesh||!playerCarMesh)return;
    // Predict ball position a short time ahead
    const predictTime=0.4;
    const predictedBall=new THREE.Vector3(
      ball.position.x+ballVel.x*predictTime,
      ball.position.y+ballVel.y*predictTime,
      ball.position.z+ballVel.z*predictTime
    );
    const aimTarget=new THREE.Vector3(0,0,-GOAL_LINE);
    // Decide if AI should go for ball or defend
    const ballInAIHalf=ball.position.z>0;
    const distToBall=aiCarMesh.position.distanceTo(predictedBall);
    // Find nearest active boost pad for AI
    let nearestPad=null,nearestPadDist=Infinity;
    boostPads.forEach(pad=>{
      if(!pad.active)return;
      const d=Math.sqrt((aiCarMesh.position.x-pad.x)**2+(aiCarMesh.position.z-pad.z)**2);
      if(d<nearestPadDist){nearestPadDist=d;nearestPad=pad;}
    });
    let targetPoint;
    // If AI has very low boost and pad is close, go grab it first
    if(boost2<40&&nearestPadDist<20&&distToBall>nearestPadDist+5){
      targetPoint=new THREE.Vector3(nearestPad.x,aiCarMesh.position.y,nearestPad.z);
    } else {
      const ballToGoal=new THREE.Vector3().subVectors(aimTarget,predictedBall).normalize();
      targetPoint=predictedBall.clone().sub(ballToGoal.clone().multiplyScalar(7));
      targetPoint.y=aiCarMesh.position.y;
    }
    const toAim=new THREE.Vector3().subVectors(targetPoint,aiCarMesh.position);
    const targetAngle=Math.atan2(toAim.x,toAim.z);
    let diff=targetAngle-aiCarMesh.rotation.y;
    while(diff>Math.PI)diff-=Math.PI*2;
    while(diff<-Math.PI)diff+=Math.PI*2;
    const steer=Math.max(-1,Math.min(1,diff*1.8));
    const wantBoost=distToBall<50&&Math.abs(diff)<0.6&&boost2>0;
    const wantJump=distToBall<12&&ball.position.y>5&&Math.abs(diff)<0.5;
    if(wantBoost)boost2=Math.max(0,boost2-30*dt);
    updateCarPhysics(aiCarMesh,aiVel,{accel:Math.abs(diff)<0.9?1:0.5,steer,boost:wantBoost,jump:wantJump},dt);
  }

  // FIX: updateCamera guards against null playerCarMesh
  function updateCamera(dt){
    if(!playerCarMesh)return;
    if(gameState==='select')return;
    const followCar=(followCamera,car)=>{
      if(!car)return;
      if(car.userData.cameraYaw===undefined)car.userData.cameraYaw=car.rotation.y;
      const yaw=car.userData.cameraYaw;
      const behind=new THREE.Vector3(0,cameraHeight,-cameraDistance).applyAxisAngle(new THREE.Vector3(0,1,0),yaw);
      const camTarget=car.position.clone().add(behind);
      const forward=new THREE.Vector3(Math.sin(yaw),0,Math.cos(yaw));
      const lookDistance=12;
      const look=ballCamEnabled?
        ball.position.clone():
        car.position.clone().addScaledVector(forward,lookDistance);
      if(!ballCamEnabled){
        look.y+=cameraHeight+Math.tan(cameraAngle*Math.PI/180)*(cameraDistance+lookDistance);
      }
      const positionResponse=(1.5+cameraStiffness*12)*(cameraTransitionSpeed/6);
      const positionBlend=1-Math.exp(-positionResponse*dt);
      const rotationBlend=1-Math.exp(-(cameraSwivelSpeed*3)*dt);
      followCamera.position.lerp(camTarget,positionBlend);
      const desiredRotation=new THREE.Quaternion().setFromRotationMatrix(
        new THREE.Matrix4().lookAt(camTarget,look,new THREE.Vector3(0,1,0))
      );
      followCamera.quaternion.slerp(desiredRotation,rotationBlend);
    };
    followCar(camera,playerCarMesh);
    if(currentMode==='multi')followCar(camera2,aiCarMesh);
  }
