      });
      const mesh=new THREE.Mesh(new THREE.SphereGeometry(0.28+Math.random()*0.22,8,8),material);
      mesh.position.copy(pos).add(new THREE.Vector3((Math.random()-0.5)*0.8,Math.random()*0.5,(Math.random()-0.5)*0.8));
      scene.add(mesh);
      demolitionSmoke.push({
        mesh,
        velocity:new THREE.Vector3((Math.random()-0.5)*1.5,1+Math.random()*1.8,(Math.random()-0.5)*1.5),
        life:0.9,
        duration:0.9,
        growth:1.6+Math.random()*1.2
      });
    }
  }
  function updateDemolitionSmoke(dt){
    demolitionSmoke=demolitionSmoke.filter(particle=>{
      particle.life-=dt;
      if(particle.life<=0){
        scene.remove(particle.mesh);
        particle.mesh.geometry.dispose();
        particle.mesh.material.dispose();
        return false;
      }
      particle.velocity.y+=0.7*dt;
      particle.mesh.position.addScaledVector(particle.velocity,dt);
      const progress=1-particle.life/particle.duration;
      const scale=1+progress*particle.growth;
      particle.mesh.scale.setScalar(scale);
      particle.mesh.material.opacity=0.62*(1-progress);
      return true;
    });
  }

