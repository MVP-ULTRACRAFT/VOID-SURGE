  .btn.confirm { border-color: #2ecc71; background: linear-gradient(135deg, #27ae60, #2ecc71); }
  .btn.confirm:hover { background: linear-gradient(135deg, #2ecc71, #27ae60); box-shadow: 0 8px 25px rgba(46,204,113,0.6); }
  #carSelect { align-items: stretch; justify-content: flex-start; overflow: hidden; background: linear-gradient(90deg,rgba(4,14,32,0.98) 0%,rgba(5,20,43,0.94) 30%,rgba(5,18,37,0.62) 42%,rgba(0,0,0,0.02) 70%); }
  .garagePanel { position: relative; z-index: 1; display: flex; flex-direction: column; width: min(36vw,470px); min-width: 340px; height: 100%; padding: 22px 18px 18px; color: white; background: linear-gradient(180deg,rgba(9,43,83,0.96),rgba(4,16,34,0.96)); border-right: 2px solid rgba(88,174,238,0.7); box-shadow: 8px 0 28px rgba(0,0,0,0.4); font-family: Arial,sans-serif; }
