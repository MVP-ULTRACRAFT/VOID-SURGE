  let fieldCollisionBounds={minX:-FIELD_W/2+FIELD_COLLISION_MARGIN,maxX:FIELD_W/2-FIELD_COLLISION_MARGIN,minZ:-FIELD_L/2+FIELD_COLLISION_MARGIN,maxZ:FIELD_L/2-FIELD_COLLISION_MARGIN};
  const gltfLoader=new THREE.GLTFLoader();
