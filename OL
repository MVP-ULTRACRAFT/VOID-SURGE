  function startTrainingDrill(drillNumber){
    if(currentMode!=='freeplay'||gameState!=='playing'||!playerCarMesh)return;

    const position=playerCarMesh.position;
    const forward=new THREE.Vector3(Math.sin(playerCarMesh.rotation.y),0,Math.cos(playerCarMesh.rotation.y));
    if(drillNumber<1||drillNumber>4)return;
    const resetBall=(ballPosition,velocity)=>{
      ball.position.copy(ballPosition);
      ballVel.copy(velocity);
      ballAngularVel.set(0,0,0);
      ball.userData.lastTouch=null;
      ball.userData.shotRegistered=false;
      ball.userData.prevZ=ball.position.z;
      ball.userData.scoredThisFrame=false;
      ball.userData.trainingShotGravityScale=null;
      ball.userData.trainingShotTimeLeft=0;
    };
    if(drillNumber===1){
      resetBall(
        position.clone().addScaledVector(forward,8).setY(BALL_R+0.5),
        new THREE.Vector3()
      );
    }else if(drillNumber===2){
      const hitboxCenter=playerCarMesh.userData.hitboxCenter||CAR_HITBOX_CENTER;
      const hitboxExtents=playerCarMesh.userData.hitboxHalfExtents||CAR_HALF_EXTENTS;
      const roofHeight=position.y+hitboxCenter.y+hitboxExtents.y;
      resetBall(
        position.clone().setY(roofHeight+BALL_R+0.1),
        new THREE.Vector3()
      );
    }else if(drillNumber===3){
      const start=position.clone().addScaledVector(forward,58).setY(BALL_R+0.5);
      const towardPlayer=position.clone().add(new THREE.Vector3(0,1.5,0)).sub(start).normalize();
      resetBall(start,towardPlayer.multiplyScalar(42));
    }else if(drillNumber===4){
      const spawnPosition=playerCarMesh.userData.spawnPosition;
      const goalSide=spawnPosition&&spawnPosition.z>0?1:-1;
      const target=new THREE.Vector3(0,BALL_R+4,goalSide*(GOAL_LINE+GOAL_DEPTH*0.5));
      const horizontalDirection=new THREE.Vector3(
        target.x-ball.position.x,0,target.z-ball.position.z
      );
      if(horizontalDirection.lengthSq()<1e-8)return;
      const horizontalSpeed=34;
      const travelTime=horizontalDirection.length()/horizontalSpeed;
      horizontalDirection.normalize().multiplyScalar(horizontalSpeed);
      const verticalSpeed=10;
      const effectiveGravity=THREE.MathUtils.clamp(
        2*(target.y-ball.position.y-verticalSpeed*travelTime)/(travelTime*travelTime),
        GRAVITY*1.3,
        GRAVITY*1.3*0.02
      );
      ballVel.copy(horizontalDirection).setY(verticalSpeed);
      ballAngularVel.set(0,0,0);
      ball.userData.lastTouch=null;
      ball.userData.shotRegistered=false;
      ball.userData.prevZ=ball.position.z;
      ball.userData.scoredThisFrame=false;
      ball.userData.trainingShotGravityScale=effectiveGravity/(GRAVITY*1.3);
      ball.userData.trainingShotTimeLeft=travelTime+0.5;
    }

    physicsAccumulator=0;
  }
  // FIX: resetPositions now resets shotRegistered
  function resetPositions(showKickoffCountdown=true){
    ball.position.set(0,BALL_R+0.5,0);ballVel.set(0,0,0);
    ballAngularVel.set(0,0,0);
    ball.userData.shotRegistered=false; // FIX
    ball.userData.lastTouch=null;
    ball.userData.trainingShotGravityScale=null;
    ball.userData.trainingShotTimeLeft=0;
    ball.userData.prevZ=ball.position.z;
    ball.userData.scoredThisFrame=false;
    playerJumps=0;aiJumps=0;jumpWasDown=false;jump2WasDown=false;
    if(playerCarMesh){const gh=playerCarMesh.userData.groundHeight||0.85;playerCarMesh.rotation.set(0,0,0);playerCarMesh.userData.spawnPosition=new THREE.Vector3(0,0,-50);playerCarMesh.userData.spawnYaw=0;playerCarMesh.position.set(0,getCarGroundContactHeight(playerCarMesh,gh),-50);playerCarMesh.visible=true;playerCarMesh.userData.demolished=false;playerCarMesh.userData.demoTimer=0;playerCarMesh.userData.cameraYaw=0;playerCarMesh.userData.firstJumpTime=null;playerCarMesh.userData.dodgeActive=false;playerCarMesh.userData.dodgeLandingRecovery=false;playerCarMesh.userData.dodgeHeadingYaw=null;playerCarMesh.userData.dodgeRecoveryPending=false;playerCarMesh.userData.dodgeSpeedBoostTimer=0;playerCarMesh.userData.dodgeRecoveryTimer=0;playerCarMesh.userData.surfaceNormal.set(0,1,0);playerCarMesh.userData.jumpSurfaceNormal.set(0,1,0);playerCarMesh.userData.surfaceJumped=false;playerCarMesh.userData.wheelContacts=4;carVel.set(0,0,0);playerCarMesh.userData.angularVelocity.set(0,0,0);playerCarMesh.userData.onGround=true;}
    if(playerCarMesh){playerCarMesh.userData.dodgePitchInputBlocked=false;playerCarMesh.userData.rightingActive=false;}
    if(aiCarMesh){const agh=aiCarMesh.userData.groundHeight||0.85;aiCarMesh.rotation.set(0,Math.PI,0);aiCarMesh.userData.spawnPosition=new THREE.Vector3(0,0,50);aiCarMesh.userData.spawnYaw=Math.PI;aiCarMesh.position.set(0,getCarGroundContactHeight(aiCarMesh,agh),50);aiCarMesh.visible=currentMode!=='freeplay';aiCarMesh.userData.demolished=false;aiCarMesh.userData.demoTimer=0;aiCarMesh.userData.cameraYaw=Math.PI;aiCarMesh.userData.firstJumpTime=null;aiCarMesh.userData.dodgeActive=false;aiCarMesh.userData.dodgeLandingRecovery=false;aiCarMesh.userData.dodgeHeadingYaw=null;aiCarMesh.userData.dodgeRecoveryPending=false;aiCarMesh.userData.dodgeSpeedBoostTimer=0;aiCarMesh.userData.dodgeRecoveryTimer=0;aiCarMesh.userData.surfaceNormal.set(0,1,0);aiCarMesh.userData.jumpSurfaceNormal.set(0,1,0);aiCarMesh.userData.surfaceJumped=false;aiCarMesh.userData.wheelContacts=4;aiVel.set(0,0,0);aiCarMesh.userData.angularVelocity.set(0,0,0);aiCarMesh.userData.onGround=true;}
    if(aiCarMesh){aiCarMesh.userData.dodgePitchInputBlocked=false;aiCarMesh.userData.rightingActive=false;}
    boost=33;boost2=33;
    updateBoostMeter('boostBar',boost);
    updateBoostMeter('player2BoostBar',boost2);
    updateScore();
    // ADDED: Start 3 2 1 GO! countdown after every goal
    if(showKickoffCountdown&&currentMode!=='freeplay')startCountdown();
    else if(currentMode==='freeplay')gameState='playing';
  }

  function renderFrame(){
    if(currentMode!=='multi'||gameState==='goal-replay'){
      renderer.setScissorTest(false);
      renderer.setViewport(0,0,innerWidth,innerHeight);
      const fullAspect=innerWidth/innerHeight;
      if(camera.aspect!==fullAspect){
        camera.aspect=fullAspect;
        camera.updateProjectionMatrix();
      }
      renderer.render(scene,camera);
      return;
    }
    const leftWidth=Math.floor(innerWidth/2);
    const rightWidth=innerWidth-leftWidth;
    renderer.setScissorTest(false);
    renderer.setViewport(0,0,innerWidth,innerHeight);
    renderer.clear();
    renderer.setScissorTest(true);
    camera.aspect=leftWidth/innerHeight;
    camera2.aspect=rightWidth/innerHeight;
    camera.updateProjectionMatrix();
    camera2.updateProjectionMatrix();
    renderer.setViewport(0,0,leftWidth,innerHeight);
    renderer.setScissor(0,0,leftWidth,innerHeight);
    renderer.render(scene,camera);
    renderer.setViewport(leftWidth,0,rightWidth,innerHeight);
    renderer.setScissor(leftWidth,0,rightWidth,innerHeight);
    renderer.render(scene,camera2);
    renderer.setScissorTest(false);
  }

  // ====== FIXED-STEP SIMULATION ======
  function simulateGameStep(dt,time){
    if(updateGoalReplay(dt,time))return;
    if(gameState==='menu'||gameState==='gameover'){
      updateCrowd(time);
      return;
    }
    if(gameState==='select'){
      updateCrowd(time);
      return;
    }
    if(gameState==='mode'||gameState==='connecting')return;
    if(goalCooldown>0)goalCooldown-=dt;
    if(saveCooldown>0)saveCooldown-=dt;
    if(currentMode==='online'&&gameState==='playing'){
      onlinePing=Math.max(20,Math.min(120,onlinePing+(Math.random()-0.5)*10));
      document.getElementById('pingDisplay').textContent=`PING: ${Math.round(onlinePing)}ms`;
    }
    if(gameState==='countdown'){
      updateCountdown(dt);updateCamera(dt);updateCrowd(time);
      return;
    }
    if(currentMode!=='freeplay'){
      matchTimer-=dt;updateTimer();
      if(matchTimer<=0){endMatch();return;}
    }
    if(keys['escape']){
      keys['escape']=false;
      if(currentMode==='freeplay')returnToMenu();
      else endMatch();
      return;
    }
    if(currentMode==='freeplay'&&keys['b']&&!ballResetWasDown){
      ball.position.set(0,BALL_R+0.5,0);
      ballVel.set(0,0,0);
      ballAngularVel.set(0,0,0);
      ball.userData.lastTouch=null;
      ball.userData.shotRegistered=false;
      ball.userData.trainingShotGravityScale=null;
      ball.userData.trainingShotTimeLeft=0;
    }
    ballResetWasDown=Boolean(keys['b']);

    let accel=0,steer=0,boosting=false,jumping=false,jumpPressed=false,powerslide=false,airRoll=0;
    let accel2=0,steer2=0,boosting2=false,jumping2=false,jumpPressed2=false,powerslide2=false,airRoll2=0;
    if(currentMode==='multi'){
      if(isLocalActionDown(0,'forward'))accel=1;if(isLocalActionDown(0,'backward'))accel=-0.7;
      if(isLocalActionDown(0,'left'))steer=1;      if(isLocalActionDown(0,'right'))steer=-1;
      if(isLocalActionDown(0,'jump'))jumping=true;
      jumpPressed=!jumpWasDown&&jumping;
      powerslide=isLocalActionDown(0,'powerslide');
      airRoll=Number(isLocalActionDown(0,'sidePitchRight'))-
        Number(isLocalActionDown(0,'sidePitchLeft'));
      if(isLocalActionDown(0,'boost')&&boost>0&&!playerCarMesh.userData.demolished){
        boosting=true;
        boost=Math.max(0,boost-30*dt);
      }
      if(isLocalActionDown(1,'forward'))accel2=1;if(isLocalActionDown(1,'backward'))accel2=-0.7;
      if(isLocalActionDown(1,'left'))steer2=1;      if(isLocalActionDown(1,'right'))steer2=-1;
      if(isLocalActionDown(1,'jump'))jumping2=true;
      jumpPressed2=!jump2WasDown&&jumping2;
      powerslide2=isLocalActionDown(1,'powerslide');
      airRoll2=Number(isLocalActionDown(1,'sidePitchRight'))-
        Number(isLocalActionDown(1,'sidePitchLeft'));
      if(isLocalActionDown(1,'boost')&&boost2>0&&!aiCarMesh.userData.demolished){
        boosting2=true;boost2=Math.max(0,boost2-30*dt);
      }
    } else {
      if(keys['w']||keys['arrowup'])accel=1;if(keys['s']||keys['arrowdown'])accel=-0.7;
      if(keys['a']||keys['arrowleft'])steer=1;
      if(keys['d']||keys['arrowright'])steer=-1;
      if(keys[' '])jumping=true;
      jumpPressed=!jumpWasDown&&jumping;
      powerslide=Boolean(keys['controlleft']);
      airRoll=Number(Boolean(keys['e']))-Number(Boolean(keys['q']));
      if(keys['shift']&&boost>0&&!playerCarMesh.userData.demolished){
        boosting=true;
        boost=Math.max(0,boost-30*dt);
      }
    }
    jumpWasDown=jumping;
    jump2WasDown=jumping2;
    updateBoostMeter('boostBar',boost);
    updateBoostMeter('player2BoostBar',boost2);
    updateCarPhysics(playerCarMesh,carVel,{accel,steer,airRoll,boost:boosting,jump:jumping,jumpPressed,dodgeDirection:new THREE.Vector2(steer,accel),simulationTime:time,powerslide,isPlayer:true},dt);
    if(currentMode==='multi')updateCarPhysics(aiCarMesh,aiVel,{accel:accel2,steer:steer2,airRoll:airRoll2,boost:boosting2,jump:jumping2,jumpPressed:jumpPressed2,dodgeDirection:new THREE.Vector2(steer2,accel2),simulationTime:time,powerslide:powerslide2},dt);
    else if(currentMode!=='freeplay'){
      if(currentMode==='online'&&peerConnected&&remoteState){
        aiCarMesh.position.lerp(new THREE.Vector3(remoteState.x,remoteState.y,remoteState.z),0.25);
        aiCarMesh.rotation.set(
          Number.isFinite(remoteState.rotX)?remoteState.rotX:0,
          remoteState.rotY,
          Number.isFinite(remoteState.rotZ)?remoteState.rotZ:0
        );
        aiVel.x=remoteState.vx;aiVel.y=remoteState.vy;aiVel.z=remoteState.vz;
        if(remoteState.angular&&aiCarMesh.userData.angularVelocity){
          aiCarMesh.userData.angularVelocity.set(remoteState.angular.x,remoteState.angular.y,remoteState.angular.z);
        }
        if(remoteState.ball&&isHost===false){
          ball.position.set(remoteState.ball.x,remoteState.ball.y,remoteState.ball.z);
          ballVel.set(remoteState.ball.vx,remoteState.ball.vy,remoteState.ball.vz);
          if(remoteState.ball.angular){
            ballAngularVel.set(remoteState.ball.angular.x,remoteState.ball.angular.y,remoteState.ball.angular.z);
          }
        }
      } else updateAI(dt);
    }
    if(currentMode!=='freeplay'&&currentMode!=='online'){
      resolveCarCollision(playerCarMesh,carVel,true,aiCarMesh,aiVel,false);
    }
    const playerSpeed=Math.hypot(carVel.x,carVel.z);
    const playerSupersonic=playerSpeed>=CAR_MAX_SPEED*0.88;
    const speedIndicator=document.getElementById('speedIndicator');
    const speedPercent=Math.round(playerSpeed/CAR_MAX_SPEED*100);
    let speedText=`SPEED ${speedPercent}%${playerSupersonic?' • SUPERSONIC':''}`;
    let anySupersonic=playerSupersonic;
    if(currentMode==='multi'){
      const player2Speed=Math.hypot(aiVel.x,aiVel.z);
      const player2Supersonic=player2Speed>=CAR_MAX_SPEED*0.88;
      speedText=`P1 ${speedPercent}%${playerSupersonic?' ⚡':''}  |  P2 ${Math.round(player2Speed/CAR_MAX_SPEED*100)}%${player2Supersonic?' ⚡':''}`;
      anySupersonic=playerSupersonic||player2Supersonic;
    }
    speedIndicator.textContent=speedText;
    speedIndicator.style.color=anySupersonic?'#ffe66d':'white';
    // detect car-on-car landings (player landing on other player)
    updateBall(dt);
    updateCamera(dt);
    updateCrowd(time);
    updateBoostPads(dt);
    updateExplosionParticles(dt);
    updateDemolitionSmoke(dt);
    updateBallTrail(dt);
    if(currentMode==='online'&&gameState==='playing'&&peerConnected){
      sendStateTimer+=dt;
      if(sendStateTimer>=0.05){
        sendStateTimer=0;
        const state={
          x:playerCarMesh.position.x,y:playerCarMesh.position.y,z:playerCarMesh.position.z,
          rotX:playerCarMesh.rotation.x,rotY:playerCarMesh.rotation.y,rotZ:playerCarMesh.rotation.z,
          vx:carVel.x,vy:carVel.y,vz:carVel.z,
          angular:{x:playerCarMesh.userData.angularVelocity.x,y:playerCarMesh.userData.angularVelocity.y,z:playerCarMesh.userData.angularVelocity.z},
          ball:{
            x:ball.position.x,y:ball.position.y,z:ball.position.z,
            vx:ballVel.x,vy:ballVel.y,vz:ballVel.z,
            angular:{x:ballAngularVel.x,y:ballAngularVel.y,z:ballAngularVel.z}
          }
        };
        sendPeer('state',state);
      }
    }
    // Animate boost flames: pulse cones and rotate rings for a flame look
    [playerCarMesh,aiCarMesh].forEach(carObj=>{
      if(!carObj||!carObj.userData||!carObj.userData.boostFlame) return;
      const bf=carObj.userData.boostFlame;
      // target pulse based on time and whether boosting
      const visible=bf.visible;
      const t=time*40 + (carObj.position.x*3);
      const pulse=visible? (1 + 0.45*Math.abs(Math.sin(t)) ) : 0.6;
      bf.children.forEach(exhaust=>{
        exhaust.children.forEach((ch,idx)=>{
          if(!ch) return;
          // cones: scale and fade
          if(ch.geometry && (ch.geometry.type==='ConeGeometry' || ch.geometry.type==='ConeBufferGeometry')){
            const s=1 + (0.9 - idx*0.3)*(pulse-1);
            ch.scale.set(1, Math.max(0.2, s), 1);
            ch.material.opacity=THREE.MathUtils.clamp(
              ch.userData.boostBaseOpacity*(0.75+(pulse-0.6)),0.12,1
            );
            ch.position.z=ch.userData.boostBaseOffset-(pulse-1)*0.12/Math.max(carObj.scale.z,0.0001);
          }
          // rings: rotate and pulse opacity
          if(ch.geometry && (ch.geometry.type==='TorusGeometry' || ch.geometry.type==='TorusBufferGeometry')){
            ch.rotation.z += dt*6*(1 + idx*0.6);
            ch.material.opacity = THREE.MathUtils.clamp(0.15 + (pulse-0.6)*0.6,0.05,0.6);
          }
        });
      });
      // subtle group scale for visible boost
      const gScale = visible? (0.85 + (pulse-0.6)*0.6) : 0.9;
      bf.scale.lerp(new THREE.Vector3(gScale,gScale,gScale), 0.25);
    });
    if(gameState==='playing')recordGoalReplayFrame(time);
  }

  function animate(){
    requestAnimationFrame(animate);
    const frameDt=Math.min(clock.getDelta(),0.1);
    const time=clock.getElapsedTime();
    if(menuCarMesh){
      menuCarMesh.visible=gameState==='menu';
      if(gameState==='menu'){
        menuCarMesh.rotation.y=0.85+Math.sin(time*0.22)*0.035;
        menuCarMesh.position.y=0.04+Math.sin(time*1.1)*0.025;
      }
    }
    if(gameState==='menu'){
      if(playerCarMesh)playerCarMesh.visible=false;
      if(aiCarMesh)aiCarMesh.visible=false;
    }
    boostPads.forEach(pad=>{
      const visible=gameState!=='menu'&&pad.active;
      pad.mesh.visible=visible;
      pad.glow.visible=visible;
    });
    if(grassShader)grassShader.uniforms.uGrassTime.value=time;
    if(screenShake>0){
      screenShake=Math.max(0,screenShake-frameDt*2);
      const container=document.getElementById('canvas-container');
      container.style.transform=screenShake>0?`translate(${(Math.random()-0.5)*screenShake*8}px,${(Math.random()-0.5)*screenShake*8}px)`:''; 
    }
    if(['menu','gameover','select','mode','connecting'].includes(gameState)){
      simulateGameStep(frameDt,time);
      renderFrame();
      return;
    }
    physicsAccumulator+=frameDt;
    while(physicsAccumulator+1e-10>=FIXED_TIMESTEP){
      physicsTime+=FIXED_TIMESTEP;
      simulateGameStep(FIXED_TIMESTEP,physicsTime);
      physicsAccumulator=Math.max(0,physicsAccumulator-FIXED_TIMESTEP);
      if(gameState==='gameover'||gameState==='menu')break;
    }
    renderFrame();
  }

  initThree();
  animate();
  </script>
