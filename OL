  async function renderGarageBodyThumbnails(){
    const buttons=Array.from(document.querySelectorAll('#carSelect .carChoice'));
    const pending=buttons.filter(button=>!bodyThumbnailImages.has(button.dataset.carPath));
    if(!pending.length)return;
    let thumbnailRenderer;
    try{
      thumbnailRenderer=new THREE.WebGLRenderer({antialias:true,alpha:false,preserveDrawingBuffer:true});
      thumbnailRenderer.setSize(256,144,false);
      thumbnailRenderer.setPixelRatio(1);
      thumbnailRenderer.setClearColor(0x122238,1);
      const thumbnailScene=new THREE.Scene();
      thumbnailScene.add(new THREE.AmbientLight(0xffffff,1.15));
      const keyLight=new THREE.DirectionalLight(0xffffff,1.4);
      keyLight.position.set(-4,7,5);
      thumbnailScene.add(keyLight);
      const fillLight=new THREE.DirectionalLight(0x8fcaff,0.75);
      fillLight.position.set(5,3,-4);
      thumbnailScene.add(fillLight);
      const thumbnailCamera=new THREE.OrthographicCamera(-3.1,3.1,1.75,-1.75,0.1,100);
      thumbnailCamera.position.set(6,2.6,7);
      thumbnailCamera.lookAt(0,0.75,0);
      for(const button of pending){
        const path=button.dataset.carPath;
        try{
          const response=await fetch(path);
          if(!response.ok)throw new Error(`HTTP ${response.status}`);
          const buffer=await response.arrayBuffer();
          const model=await new Promise((resolve,reject)=>gltfLoader.parse(buffer,'',gltf=>resolve(gltf.scene),reject));
          const bounds=new THREE.Box3().setFromObject(model);
          const size=bounds.getSize(new THREE.Vector3());
          const center=bounds.getCenter(new THREE.Vector3());
          const scale=5/(Math.max(size.x,size.z)||1);
          model.scale.setScalar(scale);
          model.position.set(-center.x*scale,-bounds.min.y*scale,-center.z*scale);
          model.rotation.y=-0.9;
          thumbnailScene.add(model);
          thumbnailRenderer.render(thumbnailScene,thumbnailCamera);
          const image=thumbnailRenderer.domElement.toDataURL('image/png');
          bodyThumbnailImages.set(path,image);
          button.querySelector('.bodyModelThumbnail').src=image;
          thumbnailScene.remove(model);
          model.traverse(node=>{
            if(node.isMesh){
              node.geometry.dispose();
              const materials=Array.isArray(node.material)?node.material:[node.material];
              materials.forEach(material=>{
                if(material.map)material.map.dispose();
                material.dispose();
              });
            }
          });
        }catch(error){
          console.error(`Garage body thumbnail failed for ${path}:`,error);
        }
      }
    }catch(error){
      console.error('Garage thumbnail renderer failed:',error);
    }finally{
      if(thumbnailRenderer)thumbnailRenderer.dispose();
    }
    buttons.forEach(button=>{
      const image=bodyThumbnailImages.get(button.dataset.carPath);
      if(image)button.querySelector('.bodyModelThumbnail').src=image;
    });
  }
