  function createRoundedFieldShape(width,length,radius){
    const halfWidth=width/2,halfLength=length/2;
    const shape=new THREE.Shape();
    shape.moveTo(-halfWidth+radius,-halfLength);
    shape.lineTo(halfWidth-radius,-halfLength);
    shape.absarc(halfWidth-radius,-halfLength+radius,radius,-Math.PI/2,0,false);
    shape.lineTo(halfWidth,halfLength-radius);
    shape.absarc(halfWidth-radius,halfLength-radius,radius,0,Math.PI/2,false);
    shape.lineTo(-halfWidth+radius,halfLength);
    shape.absarc(-halfWidth+radius,halfLength-radius,radius,Math.PI/2,Math.PI,false);
    shape.lineTo(-halfWidth,-halfLength+radius);
    shape.absarc(-halfWidth+radius,-halfLength+radius,radius,Math.PI,Math.PI*1.5,false);
    return shape;
  }
  function createFieldEdgeBevel(
    width,length,cornerRadius,bevelRadius,material,invertY=false,carveGoalOpening=false
  ){
    const positions=[],uvs=[],indices=[];
    const halfWidth=width/2,halfLength=length/2;
    const straightSegments=96,crossSectionSegments=16,cornerSegments=32;
    const appendVertex=(x,y,z)=>{
      positions.push(x,y,z);
      uvs.push((x+halfWidth)/width,(z+halfLength)/length);
      return positions.length/3-1;
    };
    const appendQuad=(a,b,c,d)=>{
      indices.push(a,b,d,b,c,d);
    };
    const appendStrip=(pointAt,alongSegments,acrossSegments,skipQuad=null)=>{
      const start=positions.length/3;
