  function createCarByType(type,color,modelTemplate=carModelTemplate,modelName=carModelName,gameplay=false){
    if(!modelTemplate)return null;
    const car=modelTemplate.clone(true);
    car.rotation.order='YXZ';
    if(gameplay&&modelName.toLowerCase().includes('octane')&&car.children[0]){
      car.children[0].position.y-=CAR_OCTANE_GAMEPLAY_LOWERING;
      car.userData.useHitboxGroundContact=true;
    }
    car.traverse(node=>{
      if(node.isMesh){
        node.castShadow=true;
        node.receiveShadow=true;
        node.visible=true;
        node.renderOrder=2;
      }
    });
    const hitboxName=getHitboxForCarName(modelName);
    const hitbox=CAR_HITBOX_PRESETS[hitboxName];
    car.userData.hitboxName=hitboxName;
    car.userData.hitboxHalfExtents=new THREE.Vector3(
      hitbox.width*HITBOX_SCALE/2,
      hitbox.height*HITBOX_SCALE/2,
      hitbox.length*HITBOX_SCALE/2
    );
    car.userData.hitboxCenter=new THREE.Vector3(0,car.userData.hitboxHalfExtents.y,0);
    const boostFlame=new THREE.Group();
    boostFlame.visible=false;
    car.updateMatrixWorld(true);
    const bodyBounds=new THREE.Box3().setFromObject(car);
    const localMin=car.worldToLocal(bodyBounds.min.clone());
    const localMax=car.worldToLocal(bodyBounds.max.clone());
    const modelWidth=localMax.x-localMin.x;
    const modelHeight=localMax.y-localMin.y;
    const modelScale=1/Math.max(car.scale.x,0.0001);
    const exhaustOffsets=[-modelWidth*0.105,modelWidth*0.105];
    const exhaustY=localMin.y+modelHeight*0.36;
    const exhaustZ=localMin.z-0.03*modelScale;
    const flameLayers=[
      {radius:0.15,length:1.05,color:0xff4a16,opacity:0.45},
      {radius:0.105,length:0.78,color:0xffa51e,opacity:0.72},
      {radius:0.055,length:0.48,color:0xfff1a8,opacity:0.95}
    ];
    exhaustOffsets.forEach(offsetX=>{
      const exhaust=new THREE.Group();
      exhaust.position.set(offsetX,exhaustY,exhaustZ);
      flameLayers.forEach(layer=>{
        const flame=new THREE.Mesh(
          new THREE.ConeGeometry(layer.radius*modelScale,layer.length*modelScale,10),
          new THREE.MeshBasicMaterial({
            color:layer.color,
            transparent:true,opacity:layer.opacity,blending:THREE.AdditiveBlending,depthWrite:false
          })
        );
        flame.rotation.x=-Math.PI/2;
        flame.position.z=-layer.length*modelScale/2;
        flame.userData.boostBaseOffset=flame.position.z;
        flame.userData.boostBaseOpacity=layer.opacity;
        exhaust.add(flame);
      });
      const ring=new THREE.Mesh(
        new THREE.TorusGeometry(0.09*modelScale,0.012*modelScale,8,16),
        new THREE.MeshBasicMaterial({color:0xffd17f,transparent:true,opacity:0.35,blending:THREE.AdditiveBlending,depthWrite:false})
      );
      ring.rotation.x=Math.PI/2;ring.position.z=-0.16*modelScale;exhaust.add(ring);
      const ring2=new THREE.Mesh(
        new THREE.TorusGeometry(0.055*modelScale,0.008*modelScale,6,12),
        new THREE.MeshBasicMaterial({color:0xff8d2b,transparent:true,opacity:0.32,blending:THREE.AdditiveBlending,depthWrite:false})
      );
      ring2.rotation.x=Math.PI/2;ring2.position.z=-0.38*modelScale;exhaust.add(ring2);
      const boostLight=new THREE.PointLight(0xff9a38,1.3,3);
      boostLight.position.z=-0.22*modelScale;
      exhaust.add(boostLight);
      boostFlame.add(exhaust);
    });
    car.add(boostFlame);
    car.visible=true;
    car.userData.onGround=true;
    car.userData.surfaceNormal=new THREE.Vector3(0,1,0);
    car.userData.jumpSurfaceNormal=new THREE.Vector3(0,1,0);
    car.userData.wheelContacts=4;
    car.userData.groundHeight=0.35;
    car.userData.boostFlame=boostFlame;
    car.userData.modelType=type;
    car.userData.angularVelocity=new THREE.Vector3();
    car.userData.dodgePitchInputBlocked=false;
    car.userData.rightingActive=false;
    car.userData.demolished=false;
    car.userData.demoTimer=0;
    return car;
  }
  function getHitboxForCarName(name){
    const modelName=name.toLowerCase();
    if(modelName.includes('dominus'))return 'dominus';
    if(modelName.includes('breakout'))return 'breakout';
    if(modelName.includes('merc'))return 'merc';
    if(modelName.includes('plank')||modelName.includes('batmobile'))return 'plank';
    if(modelName.includes('hybrid'))return 'hybrid';
    return 'octane';
  }

