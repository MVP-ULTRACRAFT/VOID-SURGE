  // ====== INIT THREE.JS ======
  function initThree(){
    const container=document.getElementById('canvas-container');
    scene=new THREE.Scene();
    scene.background=new THREE.Color(0x87ceeb);
    scene.fog=new THREE.Fog(0x87ceeb,300,750);
    camera=new THREE.PerspectiveCamera(cameraFOV,innerWidth/innerHeight,0.1,1000);
    camera2=new THREE.PerspectiveCamera(cameraFOV,innerWidth/innerHeight,0.1,1000);
    document.getElementById('cameraHeightControl').value=cameraHeight;
    document.getElementById('cameraHeightValue').textContent=cameraHeight;
    document.getElementById('cameraDistanceControl').value=cameraDistance;
    document.getElementById('cameraDistanceValue').textContent=cameraDistance;
    document.getElementById('cameraAngleControl').value=cameraAngle;
    document.getElementById('cameraAngleValue').textContent=`${cameraAngle}°`;
    document.getElementById('cameraStiffnessControl').value=cameraStiffness;
    document.getElementById('cameraStiffnessValue').textContent=cameraStiffness.toFixed(1);
    document.getElementById('cameraSwivelControl').value=cameraSwivelSpeed;
    document.getElementById('cameraSwivelValue').textContent=cameraSwivelSpeed.toFixed(1);
    document.getElementById('cameraTransitionControl').value=cameraTransitionSpeed;
    document.getElementById('cameraTransitionValue').textContent=cameraTransitionSpeed.toFixed(1);
    document.getElementById('fovControl').value=cameraFOV;
    document.getElementById('fovValue').textContent=cameraFOV;
    renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});
    renderer.setSize(innerWidth,innerHeight);
    renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
    renderer.shadowMap.enabled=true;
    renderer.shadowMap.type=THREE.PCFSoftShadowMap;
    container.appendChild(renderer.domElement);
    scene.add(new THREE.AmbientLight(0xffffff,0.5));
    const sun=new THREE.DirectionalLight(0xffffff,0.9);
    sun.position.set(80,120,60);
    sun.castShadow=true;
    sun.shadow.camera.left=-180;sun.shadow.camera.right=180;
    sun.shadow.camera.top=180;sun.shadow.camera.bottom=-180;
    sun.shadow.mapSize.set(1024,1024);
    scene.add(sun);
    [[-1,1],[1,1],[-1,-1],[1,-1]].forEach(([sx,sz])=>{
      const pl=new THREE.PointLight(0xffeecc,0.08,180);
      pl.position.set(sx*STADIUM_W/2*0.9,40,sz*STADIUM_L/2*0.9);
      scene.add(pl);
    });
    buildField();
    buildStadiumSeats();
    buildGoals();
    buildBoostPads();
    // Ball
    const ballGeo=new THREE.SphereGeometry(BALL_R,32,32);
    const ballMat=new THREE.MeshStandardMaterial({color:0xffffff,roughness:0.4,metalness:0.1,emissive:0x222222});
    ball=new THREE.Mesh(ballGeo,ballMat);
    ball.castShadow=true;
    ball.visible=false;
    ball.position.set(0,BALL_R+0.5,0);
    ball.userData={shotRegistered:false,lastTouch:null};
    scene.add(ball);
    addBallPattern();
    ball.add(new THREE.PointLight(0xffffff,0.6,15));
    // Ball trail
    for(let i=0;i<20;i++){
      const tp=new THREE.Mesh(
        new THREE.SphereGeometry(BALL_R*0.6*(1-i/20),8,8),
        new THREE.MeshBasicMaterial({color:new THREE.Color().setHSL(0.6,1,0.6),transparent:true,opacity:0})
      );
      tp.visible=false;
      scene.add(tp);
      ballTrailParticles.push({mesh:tp,life:0});
    }
    playerCarMesh=null;
    aiCarMesh=null;
    window.addEventListener('keydown',e=>{
      if(keybindCaptureAction){
        e.preventDefault();
        captureLocalKeybind(e);
        return;
      }
      if(e.code==='KeyC'&&gameState==='playing'&&!e.repeat){
        ballCamEnabled=!ballCamEnabled;
        e.preventDefault();
      }
      keys[e.key.toLowerCase()]=true;
      keys[e.code.toLowerCase()]=true;
      if(currentMode==='freeplay'&&gameState==='playing'&&/^[1-4]$/.test(e.key)){
        e.preventDefault();
        if(!e.repeat)startTrainingDrill(Number(e.key));
      }
      if([' ','arrowup','arrowdown','arrowleft','arrowright','enter','backspace'].includes(e.key.toLowerCase())||
        (currentMode==='multi'&&isLocalControlCode(e.code)))e.preventDefault();
    });
    window.addEventListener('keyup',e=>{
      keys[e.key.toLowerCase()]=false;
      keys[e.code.toLowerCase()]=false;
    });
    document.querySelectorAll('[data-touch-player][data-touch-action]').forEach(button=>{
      const startTouch=e=>{
        e.preventDefault();
        if(activeTouchKeys.has(e.pointerId))return;
        const key=keyForTouchAction(Number(button.dataset.touchPlayer),button.dataset.touchAction);
        if(!key)return;
        activeTouchKeys.set(e.pointerId,key);
        keys[key]=true;
        button.classList.add('isPressed');
        if(button.setPointerCapture)button.setPointerCapture(e.pointerId);
      };
      const endTouch=e=>{
        const key=activeTouchKeys.get(e.pointerId);
        if(!key)return;
        activeTouchKeys.delete(e.pointerId);
        if(!Array.from(activeTouchKeys.values()).includes(key))keys[key]=false;
        button.classList.remove('isPressed');
      };
      button.addEventListener('pointerdown',startTouch);
      button.addEventListener('pointerup',endTouch);
      button.addEventListener('pointercancel',endTouch);
      button.addEventListener('lostpointercapture',endTouch);
    });
    window.addEventListener('resize',()=>{
