          node.receiveShadow=true;
          const materials=Array.isArray(node.material)?node.material:[node.material];
          const meshBounds=new THREE.Box3().setFromObject(node);
          const meshCenter=meshBounds.getCenter(new THREE.Vector3());
          const meshHeight=meshBounds.max.y-meshBounds.min.y;
          const isWall=meshHeight>4&&meshCenter.y>4;
          materials.forEach(material=>{
            if(!material)return;
            material.transparent=isWall;
            material.opacity=isWall?0.2:1;
            material.depthWrite=!isWall;
            material.side=THREE.DoubleSide;
            if(isWall){
              material.map=null;
              material.color.set(meshCenter.z<0?0x2455d6:0xd92727);
              material.emissive.set(meshCenter.z<0?0x071536:0x360707);
              material.emissiveIntensity=0.18;
            }
            material.needsUpdate=true;
          });
        }
      });
      if(scene.userData.proceduralField){scene.remove(scene.userData.proceduralField);scene.userData.proceduralField=null;}
      if(fieldModel)scene.remove(fieldModel);
      fieldModel=model;
      scene.add(fieldModel);
      buildFieldDetails();
    },error=>console.error('Field GLB loading failed:',error))).catch(error=>console.error('Field GLB request failed:',error));
  }
  function buildFieldDetails(){
    if(fieldDetails)scene.remove(fieldDetails);
    fieldDetails=new THREE.Group();
    fieldDetails.name='detailedPitchMarkings';
    const whiteMat=new THREE.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:0.9,side:THREE.DoubleSide});
    const blueMat=new THREE.MeshBasicMaterial({color:0x2455d6,transparent:true,opacity:0.16,side:THREE.DoubleSide});
    const redMat=new THREE.MeshBasicMaterial({color:0xd92727,transparent:true,opacity:0.16,side:THREE.DoubleSide});
    const addLine=(width,length,x,z,material=whiteMat)=>{
      const line=new THREE.Mesh(new THREE.PlaneGeometry(width,length),material);
      line.rotation.x=-Math.PI/2;
      line.position.set(x,0.035,z);
      line.renderOrder=1;
      fieldDetails.add(line);
    };
    addLine(FIELD_W-2*(FIELD_EDGE_BEVEL+2),0.7,0,0);
    addLine(0.7,FIELD_L-2*(FIELD_CORNER_RADIUS+FIELD_EDGE_BEVEL+2),
      -FIELD_W/2+FIELD_EDGE_BEVEL+2,0);
    addLine(0.7,FIELD_L-2*(FIELD_CORNER_RADIUS+FIELD_EDGE_BEVEL+2),
      FIELD_W/2-FIELD_EDGE_BEVEL-2,0);
    const centerCircle=new THREE.Mesh(new THREE.RingGeometry(17.5,18.2,64),whiteMat);
    centerCircle.rotation.x=-Math.PI/2;centerCircle.position.set(0,0.04,0);fieldDetails.add(centerCircle);
    const centerSpot=new THREE.Mesh(new THREE.CircleGeometry(1.1,24),whiteMat);
    centerSpot.rotation.x=-Math.PI/2;centerSpot.position.set(0,0.045,0);fieldDetails.add(centerSpot);
    [-1,1].forEach(side=>{
      const zoneMat=side<0?blueMat:redMat;
      const zone=new THREE.Mesh(new THREE.PlaneGeometry(FIELD_W-4,28),zoneMat);
      zone.rotation.x=-Math.PI/2;zone.position.set(0,0.025,side*(FIELD_L/2-14));fieldDetails.add(zone);
      const boxZ=side*(FIELD_L/2-25);
      addLine(0.7,22,-20,boxZ);
      addLine(0.7,22,20,boxZ);
      addLine(40,0.7,0,side*(FIELD_L/2-25));
      const arc=new THREE.Mesh(new THREE.RingGeometry(11.5,12.2,32,1,side<0?Math.PI/2:Math.PI*1.5,Math.PI),whiteMat);
      arc.rotation.x=-Math.PI/2;arc.position.set(0,0.045,side*(FIELD_L/2-25));fieldDetails.add(arc);
    });
    [-1,1].forEach(x=>[-1,1].forEach(z=>{
      const corner=new THREE.Mesh(new THREE.RingGeometry(5.5,6.1,24,1,0,Math.PI/2),whiteMat);
      corner.rotation.x=-Math.PI/2;
      corner.position.set(x*(FIELD_W/2-FIELD_CORNER_RADIUS),0.045,
        z*(FIELD_L/2-FIELD_CORNER_RADIUS));
      fieldDetails.add(corner);
    }));
    scene.add(fieldDetails);
  }
