    const stored=localStorage.getItem('rl3d_local_keybinds');
    if(!stored)return DEFAULT_LOCAL_KEYBINDS.map(bindings=>({...bindings}));
    try{
      const parsed=JSON.parse(stored);
      return DEFAULT_LOCAL_KEYBINDS.map((defaults,index)=>{
        const saved=parsed[index];
        const merged={...defaults};
        const oldPlayerTwoDefaults={forward:'ArrowUp',backward:'ArrowDown',left:'ArrowLeft',right:'ArrowRight'};
        if(saved&&typeof saved==='object'){
          LOCAL_KEYBIND_ACTIONS.forEach(([action])=>{
            const isOldPlayerTwoDefault=index===1&&saved[action]===oldPlayerTwoDefaults[action];
            if(!isOldPlayerTwoDefault&&typeof saved[action]==='string'&&/^[A-Za-z][A-Za-z0-9]+$/.test(saved[action]))merged[action]=saved[action];
          });
        }
        return merged;
      });
    }catch(error){
      console.warn('Saved local multiplayer keybinds could not be read; using defaults.',error);
      return DEFAULT_LOCAL_KEYBINDS.map(bindings=>({...bindings}));
    }
