  const readCameraSetting=(key,fallback,min,max)=>{
    const saved=localStorage.getItem(key);
    if(saved===null)return fallback;
    const stored=Number(saved);
    return Number.isFinite(stored)&&stored>=min&&stored<=max?stored:fallback;
  };
  let cameraHeight=readCameraSetting('rl3d_camera_height',13,6,24);
  let cameraDistance=readCameraSetting('rl3d_camera_distance',24,12,40);
  let cameraAngle=readCameraSetting('rl3d_camera_angle',-16,-20,0);
